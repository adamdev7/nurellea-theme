{%- liquid
  assign p = section.settings.product | default: product | default: settings.nurellea_product
  assign directions = p.metafields.nurellea.directions
-%}
<section class="nl-section color-{{ section.settings.color_scheme }}" id="how-to-use-steps" aria-labelledby="Steps-{{ section.id }}">
  <div class="nl-container">
    <header class="nl-section-head nl-section-head--center" data-nl-reveal>
      {%- if section.settings.eyebrow != blank -%}<p class="nl-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2 id="Steps-{{ section.id }}" class="nl-h2">
        {{ section.settings.heading | escape }}
        {%- if section.settings.heading_accent != blank %} <em class="nl-accent">{{ section.settings.heading_accent | escape }}</em>{%- endif -%}
      </h2>
      {%- if section.settings.text != blank -%}<div class="nl-lead nl-muted">{{ section.settings.text }}</div>{%- endif -%}
    </header>

    {%- assign cols = section.blocks.size | at_most: 4 | at_least: 1 -%}
    <ol class="nl-grid nl-grid--{{ cols }} nl-steps" style="list-style:none;margin:0;padding:0;">
      {%- for block in section.blocks -%}
        <li class="nl-step" data-nl-reveal style="--nl-reveal-delay: {{ forloop.index0 | times: 100 }}ms" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <div class="nl-media nl-step__media">
              {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 540, 720, 900', sizes: '(min-width: 990px) 33vw, 100vw', alt: block.settings.image.alt | default: block.settings.title }}
            </div>
          {%- elsif section.settings.show_placeholders -%}
            <div class="nl-media nl-step__media">{% render 'nurellea-placeholder', label: 'Step image', art: 'routine' %}</div>
          {%- endif -%}
          <span class="nl-step__num" aria-hidden="true">{{ forloop.index }}</span>
          <h3 class="nl-feature__title">{{ block.settings.title | escape }}</h3>
          {%- if block.settings.text != blank -%}<div class="nl-feature__text">{{ block.settings.text }}</div>{%- endif -%}
        </li>
      {%- endfor -%}
    </ol>

    {%- if section.settings.show_directions and directions != blank -%}
      <div class="nl-card nl-card--soft" style="margin-top: 48px;" data-nl-reveal>
        <div class="nl-stack nl-stack--sm">
          <h3 class="nl-h4">Directions from the label</h3>
          {%- if p.metafields.nurellea.serving_size != blank -%}<p><strong>Serving size:</strong> {{ p.metafields.nurellea.serving_size.value | escape }}</p>{%- endif -%}
          <div class="nl-prose">{% render 'nurellea-rich', field: directions %}</div>
          {%- if p.metafields.nurellea.warnings != blank -%}
            <p class="nl-small nl-muted">Please read the <a href="{{ p.url }}#warnings">warnings</a> before use.</p>
          {%- endif -%}
        </div>
      </div>
    {%- elsif section.settings.show_directions and request.design_mode -%}
      <p class="nl-setup-note">Add <code>nurellea.directions</code> to the product to show the label directions here.</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Nurellea routine steps",
  "tag": "div",
  "settings": [
    { "type": "product", "id": "product", "label": "Product (for directions)" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Your daily ritual" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Three simple steps," },
    { "type": "text", "id": "heading_accent", "label": "Heading accent (italic)", "default": "every day" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "checkbox", "id": "show_placeholders", "label": "Show image placeholders when no image", "default": false },
    { "type": "checkbox", "id": "show_directions", "label": "Show label directions from product", "default": false }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "limit": 4,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Step" },
        { "type": "richtext", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [{ "name": "Nurellea routine steps" }]
}
{% endschema %}
