<section class="nl-section color-{{ section.settings.color_scheme }}" aria-labelledby="NotFound-{{ section.id }}">
  <span class="nl-orb" style="inline-size: 480px; block-size: 480px; inset-inline-end: -140px; inset-block-start: -160px; --nl-orb-opacity: .5;" aria-hidden="true"></span>
  <div class="nl-container nl-container--narrow" style="position: relative; z-index: 1;">
    <div class="nl-status">
      <p class="nl-404__code" aria-hidden="true">404</p>
      <h1 id="NotFound-{{ section.id }}" class="nl-h2">{{ section.settings.heading | escape }}</h1>
      <div class="nl-lead nl-muted">{{ section.settings.text }}</div>
      <form action="{{ routes.search_url }}" method="get" role="search" class="nl-newsletter" style="width: 100%;">
        <label class="visually-hidden" for="NotFoundSearch">Search the store</label>
        <input id="NotFoundSearch" type="search" name="q" placeholder="Search the store">
        <button type="submit" class="button nl-btn">Search</button>
      </form>
      <div class="nl-actions">
        <a class="button nl-btn" href="{{ settings.nurellea_product.url | default: routes.all_products_collection_url }}">Shop Gut Gummies</a>
        <a class="button-secondary nl-btn" href="{{ routes.root_url }}">Back to home</a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Nurellea 404",
  "tag": "div",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-2" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "This page wandered off" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>The page you're looking for doesn't exist or may have moved. Try a search, or head back to something lovely.</p>" }
  ]
}
{% endschema %}
