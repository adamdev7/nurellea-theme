{%- liquid
  assign scope_product = nil
  if section.settings.scope == 'product'
    assign scope_product = section.settings.product | default: product | default: settings.nurellea_product
  endif

  assign app_blocks = section.blocks | where: 'type', '@app'
  assign use_native = true
  if section.settings.app_only and app_blocks.size > 0
    assign use_native = false
  endif

  assign count = 0
  assign sum = 0
  assign d1 = 0
  assign d2 = 0
  assign d3 = 0
  assign d4 = 0
  assign d5 = 0
  for review in shop.metaobjects.nurellea_review.values
    if scope_product != blank
      if review.product.value == blank or review.product.value.id != scope_product.id
        continue
      endif
    endif
    assign r = review.rating.value.rating | default: review.rating.value | default: 0 | round
    if r < 1
      continue
    endif
    assign count = count | plus: 1
    assign sum = sum | plus: r
    case r
      when 1
        assign d1 = d1 | plus: 1
      when 2
        assign d2 = d2 | plus: 1
      when 3
        assign d3 = d3 | plus: 1
      when 4
        assign d4 = d4 | plus: 1
      else
        assign d5 = d5 | plus: 1
    endcase
  endfor
  if count > 0
    assign avg = sum | times: 1.0 | divided_by: count | round: 1
  endif

  assign demo = false
  if settings.reviews_demo_preview and request.design_mode
    assign demo = true
  endif

  assign show_form = false
  if settings.reviews_allow_submissions and section.settings.show_form
    assign show_form = true
  endif

  assign render_section = true
  if section.settings.hide_when_empty and count == 0 and app_blocks.size == 0 and demo == false and show_form == false
    assign render_section = false
  endif
  assign limit = section.settings.limit
  if limit == 0
    assign limit = 1000
  endif
-%}

{%- if render_section -%}
<section class="nl-section color-{{ section.settings.color_scheme }}" id="reviews" aria-labelledby="Reviews-{{ section.id }}">
  <div class="nl-container">
    <header class="nl-section-head nl-section-head--split" data-nl-reveal>
      <div class="nl-stack nl-stack--sm">
        {%- if section.settings.eyebrow != blank -%}<p class="nl-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2 id="Reviews-{{ section.id }}" class="nl-h2">
          {{ section.settings.heading | escape }}
          {%- if section.settings.heading_accent != blank %} <em class="nl-accent">{{ section.settings.heading_accent | escape }}</em>{%- endif -%}
        </h2>
        {%- if count > 0 and use_native -%}
          <p class="nl-rating-summary">
            {% render 'nurellea-stars', rating: avg, size: 20 %}
            <span><strong>{{ avg }}</strong> out of 5 · based on {{ count }} published {{ count | pluralize: 'review', 'reviews' }}</span>
          </p>
        {%- endif -%}
      </div>
      {%- if section.settings.link_label != blank and section.settings.link_url != blank -%}
        <a class="button-secondary nl-btn" href="{{ section.settings.link_url }}">{{ section.settings.link_label | escape }}</a>
      {%- endif -%}
    </header>

    {%- for block in app_blocks -%}
      <div {{ block.shopify_attributes }} style="margin-block-end: 32px;">{% render block %}</div>
    {%- endfor -%}

    {%- if demo -%}
      <div class="nl-preview-banner" role="note" style="margin-block-end: 24px;">
        {% render 'nurellea-icon', name: 'alert' %}
        Development preview: the dashed cards below are sample reviews for layout only. They are not real customers, are visible only in the theme editor, and are never published or used in ratings or structured data.
      </div>
    {%- endif -%}

    {%- if use_native -%}
      <div data-nl-reviews data-page-size="{{ section.settings.page_size }}">
        {%- if section.settings.show_filters and count > 1 -%}
          <div class="nl-toolbar">
            <div class="nl-filter-group" role="group" aria-label="Filter reviews">
              <button type="button" class="nl-filter" data-nl-reviews-filter="all" aria-pressed="true">All (<span data-nl-reviews-count>{{ count }}</span>)</button>
              {%- assign dist = d5 | append: ',' | append: d4 | append: ',' | append: d3 | append: ',' | append: d2 | append: ',' | append: d1 | split: ',' -%}
              {%- for n in dist -%}
                {%- assign stars = 6 | minus: forloop.index -%}
                {%- if n != '0' -%}
                  <button type="button" class="nl-filter" data-nl-reviews-filter="rating-{{ stars }}" aria-pressed="false">{{ stars }} ★ ({{ n }})</button>
                {%- endif -%}
              {%- endfor -%}
              <button type="button" class="nl-filter" data-nl-reviews-filter="verified" aria-pressed="false">Verified purchases</button>
              <button type="button" class="nl-filter" data-nl-reviews-filter="media" aria-pressed="false">With photos</button>
            </div>
            <label class="nl-small" style="display:inline-flex;gap:10px;align-items:center;">
              Sort
              <select class="nl-select" data-nl-reviews-sort>
                <option value="newest">Newest</option>
                <option value="oldest">Oldest</option>
                <option value="highest">Highest rated</option>
                <option value="lowest">Lowest rated</option>
              </select>
            </label>
          </div>
        {%- endif -%}

        <div class="nl-grid nl-grid--{{ section.settings.columns }}" data-nl-reviews-list>
          {%- assign rendered = 0 -%}
          {%- for review in shop.metaobjects.nurellea_review.values -%}
            {%- liquid
              if scope_product != blank
                if review.product.value == blank or review.product.value.id != scope_product.id
                  continue
                endif
              endif
              assign r = review.rating.value.rating | default: review.rating.value | default: 0 | round
              if r < 1
                continue
              endif
              if rendered >= limit
                break
              endif
              assign rendered = rendered | plus: 1
              assign verified = false
              if review.verified_purchase.value == true and review.order_reference != blank
                assign verified = true
              endif
              assign has_media = false
              if review.image != blank
                assign has_media = true
              endif
            -%}
            <article
              class="nl-card nl-review-card"
              data-nl-review
              data-rating="{{ r }}"
              data-date="{{ review.submitted_on.value | date: '%Y-%m-%d' }}"
              data-verified="{{ verified }}"
              data-has-media="{{ has_media }}"
            >
              <div class="nl-review-card__head">
                {% render 'nurellea-stars', rating: r %}
                {%- if review.submitted_on != blank -%}
                  <time class="nl-small nl-muted" datetime="{{ review.submitted_on.value | date: '%Y-%m-%d' }}">{{ review.submitted_on.value | date: '%b %d, %Y' }}</time>
                {%- endif -%}
              </div>
              {%- if review.title != blank -%}<h3 class="nl-review-card__title">{{ review.title.value | escape }}</h3>{%- endif -%}
              {%- if review.body != blank -%}<div class="nl-review-card__body">{{ review.body.value | escape | newline_to_br }}</div>{%- endif -%}
              {%- if has_media -%}
                <div class="nl-media nl-review-card__media">
                  {{ review.image.value | image_url: width: 400 | image_tag: loading: 'lazy', alt: 'Photo shared by the reviewer', width: 120, height: 120 }}
                </div>
              {%- endif -%}
              {%- if review.reply != blank -%}
                <div class="nl-card nl-card--soft nl-small" style="padding: 14px 16px;">
                  <strong>Reply from {{ shop.name | escape }}:</strong> {{ review.reply.value | escape | newline_to_br }}
                </div>
              {%- endif -%}
              <div class="nl-review-card__meta">
                <span>{{ review.author.value | default: 'Customer' | escape }}{% if review.location != blank %} · {{ review.location.value | escape }}{% endif %}</span>
                {%- if verified -%}
                  <span class="nl-review-card__verified">{% render 'nurellea-icon', name: 'verified' %}Verified purchase</span>
                {%- endif -%}
                {%- if scope_product == blank and review.product.value != blank -%}
                  <a class="nl-small" href="{{ review.product.value.url }}">{{ review.product.value.title | escape }}</a>
                {%- endif -%}
              </div>
            </article>
          {%- endfor -%}

          {%- if demo -%}
            {%- assign demo_items = 'Sample reviewer A|5|Layout sample title|This is placeholder text to preview the review card layout. Replace with real, moderated customer reviews.;Sample reviewer B|4|Another layout sample|Placeholder text only. Demo reviews are never shown on the live store.;Sample reviewer C|5|Third layout sample|Placeholder text to check spacing with a slightly longer review body so the grid can be evaluated in the editor.' | split: ';' -%}
            {%- for item in demo_items -%}
              {%- assign parts = item | split: '|' -%}
              <article class="nl-card nl-review-card nl-review-card--demo" aria-label="Sample review (development preview)">
                <div class="nl-review-card__head">{% render 'nurellea-stars', rating: parts[1] %}<span class="nl-badge" style="background:#fff4d6;color:#5b4300;">Sample · preview only</span></div>
                <h3 class="nl-review-card__title">{{ parts[2] }}</h3>
                <div class="nl-review-card__body">{{ parts[3] }}</div>
                <div class="nl-review-card__meta"><span>{{ parts[0] }}</span></div>
              </article>
            {%- endfor -%}
          {%- endif -%}
        </div>

        {%- if count == 0 and demo == false -%}
          {%- if section.settings.trustpilot_score != blank -%}
            {%- assign trust_rating = section.settings.trustpilot_score | split: ' ' | first -%}
            <div class="nl-card nl-trust-panel">
              {% render 'nurellea-stars', rating: trust_rating, size: 22 %}
              <p class="nl-h3">{{ section.settings.trustpilot_score | escape }}</p>
              <p class="nl-muted">This score is from Trustpilot. Reviews written on this website appear here after our team checks them.</p>
              {%- if section.settings.trustpilot_link != blank -%}
                <a class="button nl-btn" href="{{ section.settings.trustpilot_link }}">Read them on Trustpilot</a>
              {%- endif -%}
            </div>
          {%- else -%}
            <div class="nl-empty">
              {% render 'nurellea-icon', name: 'chat' %}
              <p class="nl-h4">No reviews yet</p>
              <p class="nl-muted">Reviews from customers appear here after they are checked by our team.{% if show_form %} Tried Nurellea? We would love to hear from you.{% endif %}</p>
            </div>
          {%- endif -%}
        {%- endif -%}

        {%- if count > 0 -%}
          <div class="nl-empty" data-nl-reviews-empty hidden style="margin-top: 20px;">
            <p class="nl-muted">No reviews match this filter.</p>
          </div>
        {%- endif -%}
        {%- if count > section.settings.page_size and rendered > section.settings.page_size -%}
          <div class="nl-actions" style="justify-content:center;margin-top:32px;">
            <button type="button" class="button-secondary nl-btn" data-nl-reviews-more>Show more reviews</button>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if show_form -%}
      {%- assign review_form_id = 'ReviewForm-' | append: section.id -%}
      <details class="nl-card nl-card--soft nl-review-form" style="margin-top: 40px;" id="write-review" data-nl-autoopen {% if section.settings.form_expanded %}open{% endif %}>
        <summary class="nl-h4" style="cursor:pointer;list-style:none;display:flex;justify-content:space-between;align-items:center;gap:16px;">
          <span>Write a review</span><span class="nl-accordion__icon" aria-hidden="true"></span>
        </summary>
        <div style="margin-top: 20px;">
          {%- form 'contact', id: review_form_id, class: 'nl-form' -%}
            {%- if form.posted_successfully? -%}
              <div class="nl-alert nl-alert--success" role="status" tabindex="-1" autofocus>
                {% render 'nurellea-icon', name: 'check-circle' %}
                <span>Thank you — your review was sent to the {{ shop.name | escape }} team. Reviews are published after moderation, so it will not appear immediately.</span>
              </div>
            {%- elsif form.errors -%}
              <div class="nl-alert nl-alert--error" role="alert" tabindex="-1" autofocus>
                {% render 'nurellea-icon', name: 'alert' %}
                <div>Your review could not be sent. Please check the fields below.{{ form.errors | default_errors }}</div>
              </div>
            {%- endif -%}
            <input type="hidden" name="contact[Form]" value="Product review">
            {%- if scope_product != blank -%}
              <input type="hidden" name="contact[Product]" value="{{ scope_product.title | escape }} ({{ scope_product.id }})">
            {%- endif -%}
            <fieldset class="nl-field" style="border:0;padding:0;margin:0;">
              <legend>Your rating <span class="nl-required" aria-hidden="true">*</span></legend>
              <div class="nl-rating-input">
                {%- for i in (1..5) reversed -%}
                  <input type="radio" id="Rating-{{ section.id }}-{{ i }}" name="contact[Rating]" value="{{ i }} / 5" required>
                  <label for="Rating-{{ section.id }}-{{ i }}" aria-label="{{ i }} {{ i | pluralize: 'star', 'stars' }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="m12 3.3 2.6 5.5 6 .7-4.4 4.1 1.2 5.9L12 16.6l-5.4 2.9 1.2-5.9-4.4-4.1 6-.7L12 3.3Z"/></svg></label>
                {%- endfor -%}
              </div>
            </fieldset>
            <div class="nl-form__row">
              <div class="nl-field">
                <label for="ReviewName-{{ section.id }}">Name shown with your review <span class="nl-required" aria-hidden="true">*</span></label>
                <input id="ReviewName-{{ section.id }}" type="text" name="contact[name]" autocomplete="given-name" required maxlength="60">
              </div>
              <div class="nl-field">
                <label for="ReviewEmail-{{ section.id }}">Email (never published) <span class="nl-required" aria-hidden="true">*</span></label>
                <input id="ReviewEmail-{{ section.id }}" type="email" name="contact[email]" autocomplete="email" required>
              </div>
            </div>
            <div class="nl-field">
              <label for="ReviewOrder-{{ section.id }}">Order number (optional)</label>
              <input id="ReviewOrder-{{ section.id }}" type="text" name="contact[Order number]" inputmode="numeric">
              <span class="nl-field__hint">Used only to confirm your purchase so we can mark the review as verified.</span>
            </div>
            <div class="nl-field">
              <label for="ReviewTitle-{{ section.id }}">Review title</label>
              <input id="ReviewTitle-{{ section.id }}" type="text" name="contact[Review title]" maxlength="120">
            </div>
            <div class="nl-field">
              <label for="ReviewBody-{{ section.id }}">Your review <span class="nl-required" aria-hidden="true">*</span></label>
              <textarea id="ReviewBody-{{ section.id }}" name="contact[body]" required maxlength="3000"></textarea>
            </div>
            <label class="nl-check">
              <input type="checkbox" name="contact[Consent to publish]" value="Yes" required>
              <span>I agree that {{ shop.name | escape }} may publish my review and first name on this website. My review reflects my own experience.</span>
            </label>
            <div><button type="submit" class="button nl-btn">Submit review</button></div>
          {%- endform -%}
        </div>
      </details>
    {%- endif -%}
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Nurellea reviews",
  "tag": "div",
  "settings": [
    { "type": "paragraph", "content": "Shows published entries of the \"Nurellea review\" metaobject (draft entries stay hidden — this is the moderation step). Add a review app block to use an app instead." },
    {
      "type": "select",
      "id": "scope",
      "label": "Reviews to show",
      "default": "product",
      "options": [
        { "value": "product", "label": "One product" },
        { "value": "all", "label": "All reviews" }
      ]
    },
    { "type": "product", "id": "product", "label": "Product", "info": "Defaults to the current or primary product." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-2" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Reviews" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "In their" },
    { "type": "text", "id": "heading_accent", "label": "Heading accent (italic)", "default": "own words" },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns",
      "default": "3",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" }
      ]
    },
    { "type": "checkbox", "id": "show_filters", "label": "Show filters & sorting", "default": true },
    { "type": "range", "id": "page_size", "label": "Reviews per page", "min": 3, "max": 24, "step": 3, "default": 9 },
    { "type": "range", "id": "limit", "label": "Maximum reviews (0 = all)", "min": 0, "max": 48, "step": 3, "default": 0 },
    { "type": "checkbox", "id": "show_form", "label": "Show review submission form", "default": true },
    { "type": "checkbox", "id": "form_expanded", "label": "Expand submission form by default", "default": false },
    { "type": "checkbox", "id": "hide_when_empty", "label": "Hide section when there are no reviews", "default": false },
    { "type": "checkbox", "id": "app_only", "label": "Only show app block (hide native reviews)", "default": false },
    { "type": "text", "id": "link_label", "label": "Link label" },
    { "type": "url", "id": "link_url", "label": "Link" },
    { "type": "header", "content": "Trustpilot" },
    { "type": "text", "id": "trustpilot_score", "label": "Score line", "info": "Shown when there are no published reviews on this site yet. Example: 4.6 from 10,561+ reviews. Leave blank to show the empty state." },
    { "type": "url", "id": "trustpilot_link", "label": "Trustpilot profile link" }
  ],
  "blocks": [{ "type": "@app" }],
  "presets": [{ "name": "Nurellea reviews" }]
}
{% endschema %}
