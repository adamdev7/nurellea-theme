{%- liquid
  assign p = product | default: settings.nurellea_product
  capture review_stats
    render 'nurellea-review-stats', product: p
  endcapture
  assign review_stats = review_stats | strip | split: '|'
  assign review_count = review_stats[0] | plus: 0
  assign review_avg = review_stats[1] | plus: 0

  assign portraits = section.blocks | where: 'type', 'portrait'
  assign has_photo = false
  for block in portraits
    if block.settings.image != blank
      assign has_photo = true
      break
    endif
  endfor

  assign cta = section.settings.button_link | default: '#buy'
-%}
<section class="nl-pdp-intro color-{{ section.settings.color_scheme }}" aria-labelledby="PdpIntro-{{ section.id }}">
  <div class="nl-pdp-intro__inner">
    <p id="PdpIntro-{{ section.id }}" class="nl-pdp-intro__title">
      {{ section.settings.heading | escape }}
      {%- if section.settings.heading_line_2 != blank -%}
        <br>{{ section.settings.heading_line_2 | escape }}
      {%- endif -%}
    </p>

    {%- if section.settings.lead != blank -%}
      <p class="nl-pdp-intro__lead">{{ section.settings.lead | escape }}</p>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <div class="nl-pdp-intro__sub">{{ section.settings.text }}</div>
    {%- endif -%}

    {%- if review_count > 0 -%}
      <a class="nl-pdp-intro__rating" href="#reviews">
        {% render 'nurellea-stars', rating: review_avg, size: 16 %}
        <span>{{ review_avg }} from {{ review_count }} {{ review_count | pluralize: 'review', 'reviews' }}</span>
      </a>
    {%- endif -%}

    {%- if has_photo or section.settings.show_faces -%}
      <ul class="nl-pdp-intro__faces" role="list" aria-hidden="true">
        {%- if has_photo -%}
          {%- for block in portraits -%}
            {%- if block.settings.image != blank -%}
              <li class="nl-pdp-intro__face" {{ block.shopify_attributes }}>
                {{
                  block.settings.image
                  | image_url: width: 160
                  | image_tag: alt: '', loading: 'lazy', widths: '80, 160', width: 80, height: 80
                }}
              </li>
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          {% render 'nurellea-faces' %}
        {%- endif -%}
      </ul>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <a class="button nl-btn nl-pdp-intro__btn" href="{{ cta }}">{{ section.settings.button_label | escape }}</a>
    {%- endif -%}

    {%- if section.settings.guarantee_title != blank or section.settings.guarantee_text != blank -%}
      <div class="nl-pdp-intro__guarantee">
        {%- if section.settings.guarantee_title != blank -%}
          {%- if section.settings.guarantee_link != blank -%}
            <a class="nl-pdp-intro__guarantee-title" href="{{ section.settings.guarantee_link }}">
          {%- else -%}
            <p class="nl-pdp-intro__guarantee-title">
          {%- endif -%}
            <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true" focusable="false">
              <circle cx="10" cy="10" r="10"/>
              <path d="m5.4 10.2 2.8 2.8 6.2-6.4" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            {{ section.settings.guarantee_title | escape }}
          {%- if section.settings.guarantee_link != blank -%}
            </a>
          {%- else -%}
            </p>
          {%- endif -%}
        {%- endif -%}
        {%- if section.settings.guarantee_text != blank -%}
          <div class="nl-pdp-intro__guarantee-text">{{ section.settings.guarantee_text }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Product intro",
  "tag": "div",
  "class": "nl-pdp-intro-section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "paragraph", "content": "Compact intro shown above the product. Ratings only appear when the product has published reviews. Portrait photos replace the built-in illustrations." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your natural ritual" },
    { "type": "text", "id": "heading_line_2", "label": "Heading, second line", "default": "starts here" },
    { "type": "text", "id": "lead", "label": "Lead", "default": "Make Nurellea part of your natural daily ritual." },
    {
      "type": "richtext",
      "id": "text",
      "label": "Supporting text",
      "default": "<p>10 functional mushrooms in one <strong>raspberry gummy</strong>.</p>"
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Start your ritual" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Leave blank to scroll to the product on this page." },
    { "type": "checkbox", "id": "show_faces", "label": "Show portrait row", "default": true, "info": "Illustrations until you add portrait photos below." },
    { "type": "header", "content": "Guarantee" },
    { "type": "text", "id": "guarantee_title", "label": "Title", "default": "30-day money-back guarantee" },
    { "type": "url", "id": "guarantee_link", "label": "Title link" },
    {
      "type": "richtext",
      "id": "guarantee_text",
      "label": "Text",
      "default": "<p>If you are not happy within <strong>30 days</strong>, simply email us and we will give you a full refund.</p>"
    }
  ],
  "blocks": [
    {
      "type": "portrait",
      "name": "Portrait",
      "limit": 8,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo", "info": "Square crop works best. Adding any photo replaces the illustrations." }
      ]
    }
  ],
  "presets": [{ "name": "Product intro" }]
}
{% endschema %}
