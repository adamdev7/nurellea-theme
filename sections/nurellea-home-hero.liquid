{%- liquid
  assign p = section.settings.product | default: settings.nurellea_product
  assign shop_url = routes.all_products_collection_url
  if section.settings.button_link != blank
    assign shop_url = section.settings.button_link
  elsif p != blank
    assign shop_url = p.url | default: shop_url
  endif
  assign promo_url = shop_url
  if section.settings.promo_link != blank
    assign promo_url = section.settings.promo_link
  endif
  assign pouch_alt = 'Nurellea Gut Gummies'
  if p != blank
    assign pouch_alt = p.title | default: pouch_alt
  endif
-%}
<div class="nh nh-hero-host">
  {%- if section.settings.show_awning -%}
    <div class="nh-awning-wrap" aria-hidden="true"><div class="nh-awning"></div></div>
  {%- endif -%}

  {%- if section.settings.show_promo and section.settings.promo_text != blank -%}
    <a class="nh-promo" href="{{ promo_url }}">
      {% render 'nurellea-home-img', image: section.settings.pouch, asset: 'nurellea-gut-gummies-pouch-480.webp', width: 480, height: 480, alt: '', class: 'nh-promo__img', loading: 'eager', sizes: '80px' %}
      {%- if section.settings.promo_tag != blank -%}<span class="nh-promo__tag">{{ section.settings.promo_tag | escape }}</span>{%- endif -%}
      <span class="nh-promo__text">{{ section.settings.promo_text | escape }}</span>
      {%- if section.settings.promo_button != blank -%}
        <span class="nh-btn">{{ section.settings.promo_button | escape }}{% render 'nurellea-icon', name: 'arrow-right' %}</span>
      {%- endif -%}
    </a>
  {%- endif -%}

  <section class="nh-hero" aria-labelledby="NhHero-{{ section.id }}">
    <div class="nh-hero__inner">
      <div class="nh-hero__content">
        {%- if section.settings.badge_1 != blank or section.settings.badge_2 != blank -%}
          <p class="nh-hero__badge">
            {%- if section.settings.show_badge_stars -%}{% render 'nurellea-home-stars' %}{%- endif -%}
            {%- if section.settings.badge_1 != blank -%}<span>{{ section.settings.badge_1 | escape }}</span>{%- endif -%}
            {%- if section.settings.badge_1 != blank and section.settings.badge_2 != blank -%}<span class="nh-hero__badge-sep" aria-hidden="true"></span>{%- endif -%}
            {%- if section.settings.badge_2 != blank -%}<span>{{ section.settings.badge_2 | escape }}</span>{%- endif -%}
          </p>
        {%- endif -%}
        <h1 id="NhHero-{{ section.id }}" class="nh-h1">
          {{- section.settings.heading | escape -}}
          {%- if section.settings.heading_line_2 != blank -%}<br>{{ section.settings.heading_line_2 | escape }}{%- endif -%}
        </h1>
        {%- if section.settings.text != blank -%}<div class="nh-hero__lead">{{ section.settings.text }}</div>{%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a class="nh-btn nh-btn--xl" href="{{ shop_url }}">{{ section.settings.button_label | escape }}</a>
        {%- endif -%}
      </div>
    </div>

    <div class="nh-hero__media">
      {% render 'nurellea-home-img', image: section.settings.image, asset: 'nl-home-hero.webp', asset_small: 'nl-home-hero-960.webp', small_w: 960, width: 1280, height: 720, alt: section.settings.image_alt, class: 'nh-hero__bg', loading: 'eager', priority: true, sizes: '(min-width: 990px) 86vw, 100vw' %}
      {%- if section.settings.show_pouch -%}
        {% render 'nurellea-home-img', image: section.settings.pouch, asset: 'nurellea-gut-gummies-pouch.webp', asset_small: 'nurellea-gut-gummies-pouch-480.webp', small_w: 480, width: 819, height: 819, alt: pouch_alt, class: 'nh-hero__pouch', loading: 'eager', sizes: '(min-width: 990px) 20vw, 40vw' %}
      {%- endif -%}
    </div>
    {%- if section.settings.sticker_1 != blank -%}
      <span class="nh-sticker nh-sticker--scallop" style="--rot: -8deg;">{% render 'nurellea-icon', name: 'mushroom' %}<span>{{ section.settings.sticker_1 | escape }}</span></span>
    {%- endif -%}
    {%- if section.settings.sticker_2 != blank -%}
      <span class="nh-sticker nh-sticker--oval" style="--rot: 12deg;">{{ section.settings.sticker_2 | escape }}</span>
    {%- endif -%}
    <span class="nh-spark nh-spark--white" style="left: 52%; top: 14%; --s: 22px;"></span>
    <span class="nh-spark" style="left: 41%; top: 12%; --s: 18px; --c: #a3434f;"></span>
  </section>
</div>

{% schema %}
{
  "name": "Home: hero",
  "tag": "div",
  "class": "nh-section-hero",
  "settings": [
    { "type": "product", "id": "product", "label": "Product", "info": "Defaults to the primary product in Theme settings." },
    { "type": "checkbox", "id": "show_awning", "label": "Show striped awning", "default": true },
    { "type": "header", "content": "Promo bar" },
    { "type": "checkbox", "id": "show_promo", "label": "Show promo bar", "default": true },
    { "type": "text", "id": "promo_tag", "label": "Tag", "default": "New" },
    { "type": "text", "id": "promo_text", "label": "Text", "default": "Raspberry Gut Gummies" },
    { "type": "text", "id": "promo_button", "label": "Button", "default": "Shop now" },
    { "type": "url", "id": "promo_link", "label": "Link", "info": "Defaults to the product." },
    { "type": "header", "content": "Content" },
    { "type": "checkbox", "id": "show_badge_stars", "label": "Show stars in badge", "default": true },
    { "type": "text", "id": "badge_1", "label": "Badge text 1", "default": "300,000+ Happy Customers" },
    { "type": "text", "id": "badge_2", "label": "Badge text 2", "default": "10 Mushrooms In 1" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Daily wellness," },
    { "type": "text", "id": "heading_line_2", "label": "Heading line 2", "default": "made delicious" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Raspberry gut gummies made with <strong>10 functional mushrooms</strong>, <strong>vegan ingredients</strong> and <strong>no synthetic sweeteners</strong> — a 2-a-day ritual you will actually look forward to.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop Gut Gummies" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Defaults to the product." },
    { "type": "header", "content": "Media" },
    { "type": "image_picker", "id": "image", "label": "Scene image", "info": "Leave empty to use the bundled raspberry scene. Keep the left side calm for the text." },
    { "type": "text", "id": "image_alt", "label": "Scene alt text", "default": "Raspberry gummies, fresh raspberries and functional mushrooms on a cream table" },
    { "type": "checkbox", "id": "show_pouch", "label": "Show pouch over the scene", "default": true },
    { "type": "image_picker", "id": "pouch", "label": "Pouch image", "info": "Transparent PNG/WebP. Defaults to the bundled Gut Gummies pouch." },
    { "type": "text", "id": "sticker_1", "label": "Round sticker", "default": "10-in-1 mushrooms" },
    { "type": "text", "id": "sticker_2", "label": "Oval sticker", "default": "Just 2 a day" }
  ],
  "presets": [{ "name": "Home: hero" }]
}
{% endschema %}
