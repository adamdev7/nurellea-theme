{
  "sections": {
    "cart-section": {
      "type": "main-cart",
      "blocks": {
        "cart-page-title": {
          "type": "_cart-title",
          "static": true,
          "settings": {
            "title": "Your cart",
            "show_count": true,
            "type_preset": "h3",
            "alignment": "left",
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {}
        },
        "cart-page-items": {
          "type": "_cart-products",
          "static": true,
          "settings": {
            "gap": 24,
            "image_ratio": "portrait",
            "dividers": true,
            "vendor": false,
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {}
        },
        "cart-page-summary": {
          "type": "_cart-summary",
          "static": true,
          "settings": {
            "extend_summary": true,
            "inherit_color_scheme": false,
            "color_scheme": "scheme-2",
            "border": "none",
            "border_width": 1,
            "border_opacity": 100,
            "border_radius": 20
          },
          "blocks": {}
        }
      },
      "settings": {
        "section_width": "page-width",
        "color_scheme": "",
        "padding-block-start": 40,
        "padding-block-end": 64
      }
    },
    "cart_assurance": {
      "type": "nurellea-trust-strip",
      "blocks": {
        "nurellea_1": {
          "type": "item",
          "settings": {
            "icon": "lock",
            "text": "Secure checkout"
          }
        },
        "nurellea_2": {
          "type": "item",
          "settings": {
            "icon": "package",
            "text": "Track your order online"
          }
        },
        "nurellea_3": {
          "type": "item",
          "settings": {
            "icon": "chat",
            "text": "Questions? Our team is here to help"
          }
        }
      },
      "block_order": [
        "nurellea_1",
        "nurellea_2",
        "nurellea_3"
      ],
      "settings": {
        "color_scheme": "scheme-1",
        "animate": false,
        "speed": 40
      }
    }
  },
  "order": [
    "cart-section",
    "cart_assurance",
    "cart_assurance",
    "cart_assurance",
    "cart_assurance"
  ]
}
