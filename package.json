{
  "name": "nurellea-theme",
  "private": true,
  "version": "1.0.0",
  "description": "Nurellea Shopify theme (Horizon-based) with preserved App Manager, Phoenix checkout and Meta CAPI integrations.",
  "type": "module",
  "scripts": {
    "test": "node --test \"tests/*.test.mjs\"",
    "theme:check": "shopify theme check --fail-level error",
    "preview": "node dev/preview/server.mjs",
    "theme:check:summary": "node dev/theme-check-summary.mjs",
    "brand:assets": "node dev/build-brand-assets.mjs",
    "audit": "node --test tests/static-audit.test.mjs"
  },
  "devDependencies": {
    "@shopify/cli": "^4.8.5",
    "jsdom": "^30.1.2",
    "liquidjs": "^10.30.0",
    "sharp": "^0.35.5"
  }
}
