{%- liquid
  assign p = product | default: section.settings.product | default: settings.nurellea_product
  assign tier_blocks = section.blocks | where: 'type', 'bundle_tier'
  assign tier_mode = false
  if tier_blocks.size > 0
    assign tier_mode = true
  endif
  assign tier_live = section.settings.bundle_discounts_live
  assign supply_days = section.settings.supply_days_per_unit | plus: 0
  assign selected_tier = section.settings.default_variant_position | minus: 1 | at_least: 0
  if selected_tier >= tier_blocks.size
    assign selected_tier = tier_blocks.size | minus: 1 | at_least: 0
  endif

  assign current_variant = p.selected_or_first_available_variant
  if tier_mode == false and p.selected_variant == blank and p.has_only_default_variant == false
    assign preferred_index = section.settings.default_variant_position | minus: 1
    assign preferred_variant = p.variants[preferred_index]
    if preferred_variant and preferred_variant.available
      assign current_variant = preferred_variant
    endif
  endif
  assign mf = p.metafields.nurellea
  assign form_id = 'NurelleaProductForm-' | append: section.id
  assign subscriptions_on = false
  if settings.subscriptions_enabled and p.selling_plan_groups.size > 0
    assign subscriptions_on = true
  endif
  assign selected_plan = p.selected_selling_plan
  if subscriptions_on == false
    assign selected_plan = nil
  endif

  capture review_stats
    render 'nurellea-review-stats', product: p
  endcapture
  assign review_stats = review_stats | strip | split: '|'
  assign review_count = review_stats[0] | plus: 0
  assign review_avg = review_stats[1] | plus: 0
-%}

{%- if p == blank -%}
  <section class="nl-section color-{{ section.settings.color_scheme }}">
    <div class="nl-container">
      <p class="nl-setup-note">Select a product for this section or set the primary product in Theme settings &gt; Nurellea store.</p>
    </div>
  </section>
{%- else -%}
<section
  id="Product-{{ section.id }}"
  class="nl-section nl-pdp color-{{ section.settings.color_scheme }}"
  data-nl-product
  data-section-id="{{ section.id }}"
  data-product-id="{{ p.id }}"
>
  <div class="nl-container nl-container--wide">
    {%- if section.settings.show_breadcrumbs -%}
      <nav class="nl-breadcrumbs" aria-label="Breadcrumb" style="margin-block-end: 20px;">
        <ol>
          <li><a href="{{ routes.root_url }}">Home</a></li>
          {%- if collection -%}
            <li><a href="{{ collection.url }}">{{ collection.title | escape }}</a></li>
          {%- else -%}
            <li><a href="{{ routes.all_products_collection_url }}">Shop</a></li>
          {%- endif -%}
          <li><span aria-current="page">{{ p.title | escape }}</span></li>
        </ol>
      </nav>
    {%- endif -%}

    <div class="nl-pdp__grid" id="buy">
      {%- comment -%} ——— Gallery ——— {%- endcomment -%}
      <div class="nl-pdp__gallery">
        <div class="nl-gallery" data-nl-gallery>
          <div class="nl-gallery__frame">
            <div
              class="nl-gallery__viewport"
              data-nl-gallery-viewport
              tabindex="0"
              role="region"
              aria-roledescription="carousel"
              aria-label="{{ p.title | escape }} media gallery"
            >
              {%- liquid
                assign slide_count = p.media.size
                if slide_count == 0
                  assign slide_count = 2
                endif
                if section.settings.show_lifestyle
                  assign slide_count = slide_count | plus: 1
                endif
                assign life_index = p.media.size | plus: 1
                if p.media.size == 0
                  assign life_index = 3
                endif
              -%}
              {%- if p.media.size > 0 -%}
                {%- for media in p.media -%}
                  <figure
                    class="nl-gallery__slide"
                    data-nl-gallery-slide
                    data-media-id="{{ media.id }}"
                    role="group"
                    aria-roledescription="slide"
                    aria-label="{{ forloop.index }} of {{ slide_count }}"
                  >
                    {%- case media.media_type -%}
                      {%- when 'image' -%}
                        {%- liquid
                          if forloop.first
                            assign loading = 'eager'
                            assign priority = 'high'
                          else
                            assign loading = 'lazy'
                            assign priority = 'auto'
                          endif
                        -%}
                        {{
                          media
                          | image_url: width: 1600
                          | image_tag:
                            widths: '480, 720, 960, 1200, 1600',
                            sizes: '(min-width: 990px) 55vw, 100vw',
                            loading: loading,
                            fetchpriority: priority,
                            alt: media.alt | default: p.title
                        }}
                      {%- when 'video' -%}
                        {{ media | video_tag: controls: true, playsinline: true, muted: true, preload: 'none', image_size: '1200x' }}
                      {%- when 'external_video' -%}
                        {{ media | external_video_tag: loading: 'lazy' }}
                      {%- when 'model' -%}
                        {{ media | model_viewer_tag: reveal: 'interaction', toggleable: true }}
                    {%- endcase -%}
                  </figure>
                {%- endfor -%}
              {%- else -%}
                <figure class="nl-gallery__slide" data-nl-gallery-slide>
                  {% render 'nurellea-placeholder', label: 'Product photo — upload product media in Shopify', art: 'jar' %}
                </figure>
                <figure class="nl-gallery__slide" data-nl-gallery-slide>
                  {% render 'nurellea-placeholder', label: 'Gummy close-up — upload product media', art: 'gummy' %}
                </figure>
              {%- endif -%}
              {%- if section.settings.show_lifestyle -%}
                <figure
                  class="nl-gallery__slide"
                  data-nl-gallery-slide
                  data-media-id="lifestyle"
                  role="group"
                  aria-roledescription="slide"
                  aria-label="{{ life_index }} of {{ slide_count }}"
                >
                  {%- if section.settings.lifestyle_image != blank -%}
                    {{
                      section.settings.lifestyle_image
                      | image_url: width: 1600
                      | image_tag:
                        widths: '480, 720, 960, 1200, 1600',
                        sizes: '(min-width: 990px) 55vw, 100vw',
                        loading: 'lazy',
                        alt: 'Raspberry gummy held in a hand'
                    }}
                  {%- else -%}
                    <img
                      src="{{ 'nl-life-hand.webp' | asset_url }}"
                      alt="Raspberry gummy held in a hand"
                      width="1200"
                      height="1200"
                      loading="lazy"
                    >
                  {%- endif -%}
                </figure>
              {%- endif -%}
            </div>
            {%- if slide_count > 1 -%}
              <button type="button" class="nl-gallery__nav nl-gallery__nav--prev" data-nl-gallery-prev aria-label="Previous image">
                {% render 'nurellea-icon', name: 'chevron-left' %}
              </button>
              <button type="button" class="nl-gallery__nav nl-gallery__nav--next" data-nl-gallery-next aria-label="Next image">
                {% render 'nurellea-icon', name: 'chevron-right' %}
              </button>
              <span class="nl-gallery__counter" data-nl-gallery-counter aria-hidden="true">1 / {{ slide_count }}</span>
            {%- endif -%}
          </div>

          {%- if slide_count > 1 -%}
            <div class="nl-gallery__thumbs" role="list">
              {%- for media in p.media -%}
                <button
                  type="button"
                  class="nl-gallery__thumb"
                  data-nl-gallery-thumb
                  role="listitem"
                  aria-label="Show media {{ forloop.index }}"
                  aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
                >
                  {{ media.preview_image | image_url: width: 180 | image_tag: loading: 'lazy', alt: '', width: 90, height: 90 }}
                </button>
              {%- endfor -%}
              {%- if section.settings.show_lifestyle -%}
                <button
                  type="button"
                  class="nl-gallery__thumb"
                  data-nl-gallery-thumb
                  role="listitem"
                  aria-label="Show the gummy in hand"
                  aria-current="false"
                >
                  {%- if section.settings.lifestyle_image != blank -%}
                    {{ section.settings.lifestyle_image | image_url: width: 180 | image_tag: loading: 'lazy', alt: '', width: 90, height: 90 }}
                  {%- else -%}
                    <img src="{{ 'nl-life-hand.webp' | asset_url }}" alt="" width="90" height="90" loading="lazy">
                  {%- endif -%}
                </button>
              {%- endif -%}
            </div>
            <div class="nl-gallery__dots">
              {%- for media in p.media -%}
                <button type="button" class="nl-gallery__dot" data-nl-gallery-dot aria-label="Show media {{ forloop.index }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}"></button>
              {%- endfor -%}
              {%- if section.settings.show_lifestyle -%}
                <button type="button" class="nl-gallery__dot" data-nl-gallery-dot aria-label="Show the gummy in hand" aria-current="false"></button>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      </div>

      {%- comment -%} ——— Product info & buy box ——— {%- endcomment -%}
      <div class="nl-pdp__info">
        <div class="nl-stack nl-stack--sm">
          {%- liquid
            if mf.highlights.value.size > 0
              assign highlights = mf.highlights.value
            else
              assign highlights = settings.facts_highlights | split: ','
            endif
            assign subtitle = mf.subtitle.value | default: settings.facts_subtitle
          -%}
          {%- if highlights.size > 0 -%}
            <div class="nl-chips">
              {%- for h in highlights limit: 4 -%}
                {%- assign h = h | strip -%}
                {%- if h != blank -%}<span class="nl-chip nl-chip--rose">{{ h | escape }}</span>{%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}
          <h1 class="nl-pdp__title">{{ p.title | escape }}</h1>
          {%- if section.settings.show_trustpilot and section.settings.trustpilot_score != blank -%}
            {%- assign trustpilot_link = section.settings.trustpilot_link | default: '#reviews' -%}
            {% render 'nurellea-trustpilot', score: section.settings.trustpilot_score, link: trustpilot_link, align: 'start' %}
          {%- elsif review_count > 0 -%}
            <a class="nl-pdp__rating" href="#reviews">
              {% render 'nurellea-stars', rating: review_avg, size: 17 %}
              <span>{{ review_avg }} · {{ review_count }} {{ review_count | pluralize: 'review', 'reviews' }}</span>
            </a>
          {%- endif -%}
          {%- if subtitle != blank -%}
            <p class="nl-pdp__subtitle">{{ subtitle | escape }}</p>
          {%- endif -%}
        </div>

        <div class="nl-price" aria-live="polite">
          {%- liquid
            assign display_price = current_variant.price
            assign display_compare = current_variant.compare_at_price
            if selected_plan
              assign alloc = current_variant.selected_selling_plan_allocation
              assign display_price = alloc.price
              assign display_compare = alloc.compare_at_price
            elsif tier_mode
              assign tier = tier_blocks[selected_tier]
              capture tier_math
                render 'nurellea-bundle-math', price: current_variant.price, qty: tier.settings.quantity, discount: tier.settings.discount, days: 0, live: tier_live
              endcapture
              assign tier_math = tier_math | strip | split: '|'
              assign display_price = tier_math[0] | plus: 0
              assign display_compare = tier_math[1] | plus: 0
            endif
          -%}
          <span class="visually-hidden">Price</span>
          <span class="nl-price__current" data-nl-price>{{ display_price | money }}</span>
          <s class="nl-price__compare" data-nl-compare {% unless display_compare > display_price %}hidden{% endunless %}>
            {%- if display_compare > display_price -%}{{ display_compare | money }}{%- endif -%}
          </s>
          <span class="nl-badge nl-badge--soft nl-price__save" data-nl-save {% unless display_compare > display_price %}hidden{% endunless %}>
            {%- if display_compare > display_price -%}Save {{ display_compare | minus: display_price | money }}{%- endif -%}
          </span>
          <span class="nl-price__unit" data-nl-unit {% unless current_variant.unit_price_measurement %}hidden{% endunless %}>
            {%- if current_variant.unit_price_measurement -%}
              {{ current_variant.unit_price | money }}/{% if current_variant.unit_price_measurement.reference_value != 1 %}{{ current_variant.unit_price_measurement.reference_value }}{% endif %}{{ current_variant.unit_price_measurement.reference_unit }}
            {%- endif -%}
          </span>
        </div>
        {%- if cart.taxes_included or shop.shipping_policy.body != blank -%}
          <p class="nl-pdp__tax">
            {%- if cart.taxes_included -%}Taxes included.{% else %}Taxes calculated at checkout.{% endif %}
            {% if shop.shipping_policy.body != blank %}<a href="{{ shop.shipping_policy.url }}">Shipping</a> calculated at checkout.{% endif %}
          </p>
        {%- endif -%}

        {%- liquid
          if mf.benefits.value.size > 0
            assign benefits = mf.benefits.value
          else
            assign benefits = settings.facts_benefits | strip | newline_to_br | split: '<br />'
          endif
        -%}
        {%- if benefits.size > 0 -%}
          <ul class="nl-pdp__benefits">
            {%- for b in benefits -%}
              {%- assign b = b | strip -%}
              {%- if b != blank -%}
                <li>{% render 'nurellea-icon', name: 'check-circle' %}<span>{{ b | escape }}</span></li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- elsif request.design_mode -%}
          <p class="nl-setup-note">Add short, verified benefit lines in Theme settings &gt; Nurellea product facts &gt; Buy box checklist. They are hidden until set.</p>
        {%- endif -%}

        {%- if section.settings.show_short_description and p.description != blank -%}
          <div class="nl-prose nl-small">{{ p.description | strip_html | truncatewords: 40 }}</div>
        {%- endif -%}

        <product-form-component
          data-section-id="{{ section.id }}"
          data-product-id="{{ p.id }}"
          data-product-url="{{ p.url }}"
          on:submit="/handleSubmit"
          data-quantity-default="{% if tier_mode %}{{ tier_blocks[selected_tier].settings.quantity | at_least: 1 }}{% else %}{{ current_variant.quantity_rule.min | default: 1 }}{% endif %}"
          data-quantity-error-max="{{ 'products.product.quantity_error_max' | t }}"
          class="nl-stack"
        >
          <div class="visually-hidden" aria-live="assertive" role="status" aria-atomic="true" ref="liveRegion"></div>
          {%- form 'product', p, id: form_id, data-type: 'add-to-cart-form' -%}
            <input type="hidden" name="id" ref="variantId" value="{{ current_variant.id }}">
            {%- if subscriptions_on -%}
              <input type="hidden" name="selling_plan" value="{{ selected_plan.id }}" {% unless selected_plan %}disabled{% endunless %}>
            {%- endif -%}

            <div class="nl-stack">
              {%- if tier_mode -%}
                {%- unless p.has_only_default_variant -%}
                  <fieldset class="nl-options">
                    <legend class="nl-options__legend"><span>{{ p.options.first | escape }}</span></legend>
                    <div class="nl-variant-pills">
                      {%- for variant in p.variants -%}
                        <label class="nl-variant-pill">
                          <input
                            type="radio"
                            name="nl-variant-{{ section.id }}"
                            value="{{ variant.id }}"
                            data-nl-variant-input
                            {% if variant.id == current_variant.id %}checked{% endif %}
                          >
                          <span>{{ variant.title | escape }}{% unless variant.available %} · Sold out{% endunless %}</span>
                        </label>
                      {%- endfor -%}
                    </div>
                  </fieldset>
                {%- endunless -%}

                {%- liquid
                  assign best_tier = -1
                  assign best_discount = 0
                  if tier_live and section.settings.show_best_value
                    for tier in tier_blocks
                      if tier.settings.discount > best_discount
                        assign best_discount = tier.settings.discount
                        assign best_tier = forloop.index0
                      endif
                    endfor
                  endif
                  assign free_ship_cents = settings.free_shipping_threshold | plus: 0 | times: 100
                  assign tier_image = current_variant.featured_image | default: p.featured_image
                -%}
                {%- if request.design_mode and tier_live == false -%}
                  <p class="nl-setup-note">
                    Bundle discounts are hidden, so every option shows the full price. Create one automatic discount per discounted option in Shopify admin → Discounts (Amount off products, this product, minimum quantity = bags), then tick “Bundle discounts are active” in this section.
                  </p>
                {%- endif -%}
                <fieldset class="nl-options nl-tiers">
                  <legend class="nl-options__legend">
                    <span>{{ section.settings.variant_heading | default: 'Choose your supply' | escape }}</span>
                  </legend>
                  {%- for tier in tier_blocks -%}
                    {%- liquid
                      assign qty = tier.settings.quantity | at_least: 1
                      capture tier_math
                        render 'nurellea-bundle-math', price: current_variant.price, qty: qty, discount: tier.settings.discount, days: supply_days, live: tier_live
                      endcapture
                      assign tier_math = tier_math | strip | split: '|'
                      assign t_total = tier_math[0] | plus: 0
                      assign t_full = tier_math[1] | plus: 0
                      assign t_each = tier_math[2] | plus: 0
                      assign t_per_day = tier_math[3] | plus: 0
                      assign t_save = tier_math[4] | plus: 0

                      assign t_title = tier.settings.title
                      if t_title == blank
                        if qty == 1
                          assign t_title = '1 ' | append: section.settings.unit_singular
                        else
                          assign t_title = qty | append: ' ' | append: section.settings.unit_plural
                        endif
                      endif
                      assign t_sub = tier.settings.subtitle
                      if t_sub == blank and supply_days > 0
                        assign t_sub = qty | times: supply_days | append: '-day supply'
                      endif

                      assign ribbon = tier.settings.badge
                      if ribbon == blank and forloop.index0 == best_tier
                        assign ribbon = section.settings.best_value_label
                      endif
                      assign stack = qty | at_most: 3
                    -%}
                    <label class="nl-option-card nl-tier{% if ribbon != blank %} nl-tier--flagged{% endif %}" data-nl-tier="{{ forloop.index0 }}" {{ tier.shopify_attributes }}>
                      <input
                        type="radio"
                        name="nl-tier-{{ section.id }}"
                        value="{{ forloop.index0 }}"
                        data-nl-tier-input
                        data-qty="{{ qty }}"
                        data-title="{{ t_title | escape }}"
                        {% if forloop.index0 == selected_tier %}checked{% endif %}
                      >
                      <span class="nl-option-card__body nl-tier__body">
                        <span class="nl-option-card__radio" aria-hidden="true"></span>
                        <span class="nl-tier__media" aria-hidden="true">
                          {%- if tier_image != blank -%}
                            {%- for i in (1..stack) -%}
                              {{ tier_image | image_url: width: 160 | image_tag: width: 64, height: 64, alt: '', loading: 'lazy', class: 'nl-tier__img' }}
                            {%- endfor -%}
                          {%- else -%}
                            <span class="nl-tier__img nl-tier__img--empty">{% render 'nurellea-icon', name: 'gummy' %}</span>
                          {%- endif -%}
                        </span>
                        <span class="nl-tier__info">
                          <span class="nl-option-card__title">{{ t_title | escape }}</span>
                          {%- if t_sub != blank -%}<span class="nl-option-card__sub">{{ t_sub | escape }}</span>{%- endif -%}
                          <span class="nl-tier__chips">
                            <span class="nl-tier__chip nl-tier__chip--outline" data-nl-tier-free {% unless free_ship_cents > 0 and t_total >= free_ship_cents %}hidden{% endunless %}>Free shipping</span>
                            <span class="nl-tier__chip" data-nl-tier-perday {% unless t_per_day > 0 %}hidden{% endunless %}>{% if t_per_day > 0 %}Just {{ t_per_day | money }}/day{% endif %}</span>
                            <span class="nl-tier__save" data-nl-tier-save {% unless t_save > 0 %}hidden{% endunless %}>{% if t_save > 0 %}Save {{ t_save | money }}{% endif %}</span>
                          </span>
                        </span>
                        <span class="nl-option-card__price nl-tier__price">
                          {%- if qty > 1 -%}
                            <strong><span data-nl-tier-each>{{ t_each | money }}</span><small>/{{ section.settings.unit_singular | escape }}</small></strong>
                            <span class="nl-tier__total"><s data-nl-tier-full {% unless t_save > 0 %}hidden{% endunless %}>{% if t_save > 0 %}{{ t_full | money }}{% endif %}</s> <span data-nl-tier-total>{{ t_total | money }}</span> total</span>
                          {%- else -%}
                            <strong data-nl-tier-total>{{ t_total | money }}</strong>
                          {%- endif -%}
                        </span>
                      </span>
                      {%- if ribbon != blank -%}
                        <span class="nl-tier__ribbon">{{ ribbon | escape }}</span>
                      {%- endif -%}
                    </label>
                  {%- endfor -%}
                </fieldset>
              {%- elsif p.has_only_default_variant == false -%}
                {%- liquid
                  # Pack count per variant: nurellea.units metafield, else the leading number of the first option value ("3 Pouches" → 3).
                  assign single_price = 0
                  assign best_unit_price = 0
                  assign best_variant_id = 0
                  for variant in p.variants
                    assign units = variant.metafields.nurellea.units.value | default: 0 | plus: 0
                    if units < 1
                      assign units = variant.option1 | split: ' ' | first | plus: 0
                    endif
                    if units < 1
                      assign units = 1
                    endif
                    if units == 1 and single_price == 0
                      assign single_price = variant.price
                    endif
                    if units > 1 and variant.available
                      assign unit_price = variant.price | times: 1.0 | divided_by: units
                      if best_unit_price == 0 or unit_price < best_unit_price
                        assign best_unit_price = unit_price
                        assign best_variant_id = variant.id
                      endif
                    endif
                  endfor
                  if single_price > 0 and best_unit_price >= single_price
                    assign best_variant_id = 0
                  endif
                  assign supply_days = section.settings.supply_days_per_unit | plus: 0
                  assign free_ship_cents = settings.free_shipping_threshold | plus: 0 | times: 100
                -%}
                <fieldset class="nl-options nl-tiers">
                  <legend class="nl-options__legend">
                    <span>{{ section.settings.variant_heading | default: p.options.first }}</span>
                  </legend>
                  {%- for variant in p.variants -%}
                    {%- liquid
                      assign v_badge = variant.metafields.nurellea.badge.value
                      assign v_caption = variant.metafields.nurellea.caption.value
                      assign units = variant.metafields.nurellea.units.value | default: 0 | plus: 0
                      if units < 1
                        assign units = variant.option1 | split: ' ' | first | plus: 0
                      endif
                      if units < 1
                        assign units = 1
                      endif
                      assign per_unit = variant.price | times: 1.0 | divided_by: units | round
                      assign per_day = 0
                      if supply_days > 0
                        assign total_days = units | times: supply_days
                        assign per_day = variant.price | times: 1.0 | divided_by: total_days | round
                      endif
                      assign save = 0
                      if variant.compare_at_price > variant.price
                        assign save = variant.compare_at_price | minus: variant.price
                      elsif single_price > 0 and units > 1
                        assign full_price = single_price | times: units
                        if full_price > variant.price
                          assign save = full_price | minus: variant.price
                        endif
                      endif
                      assign free_ship = false
                      if free_ship_cents > 0 and variant.price >= free_ship_cents
                        assign free_ship = true
                      endif
                      assign ribbon = v_badge
                      if ribbon == blank and section.settings.show_best_value and variant.id == best_variant_id
                        assign ribbon = section.settings.best_value_label
                      endif
                      assign tier_image = variant.featured_image | default: p.featured_image
                      assign stack = units
                      if stack > 3
                        assign stack = 3
                      endif
                    -%}
                    <label class="nl-option-card nl-tier{% if ribbon != blank %} nl-tier--flagged{% endif %}">
                      <input
                        type="radio"
                        name="nl-variant-{{ section.id }}"
                        value="{{ variant.id }}"
                        data-nl-variant-input
                        {% if variant.id == current_variant.id %}checked{% endif %}
                      >
                      <span class="nl-option-card__body nl-tier__body">
                        <span class="nl-option-card__radio" aria-hidden="true"></span>
                        <span class="nl-tier__media" aria-hidden="true">
                          {%- if tier_image != blank -%}
                            {%- for i in (1..stack) -%}
                              {{ tier_image | image_url: width: 160 | image_tag: width: 64, height: 64, alt: '', loading: 'lazy', class: 'nl-tier__img' }}
                            {%- endfor -%}
                          {%- else -%}
                            <span class="nl-tier__img nl-tier__img--empty">{% render 'nurellea-icon', name: 'gummy' %}</span>
                          {%- endif -%}
                        </span>
                        <span class="nl-tier__info">
                          <span class="nl-option-card__title">
                            {{ variant.title | escape }}
                            {%- unless variant.available -%}<span class="nl-badge nl-badge--ink">Sold out</span>{%- endunless -%}
                          </span>
                          {%- if v_caption != blank -%}
                            <span class="nl-option-card__sub">{{ v_caption | escape }}</span>
                          {%- endif -%}
                          {%- if free_ship or per_day > 0 or save > 0 -%}
                            <span class="nl-tier__chips">
                              {%- if free_ship -%}<span class="nl-tier__chip nl-tier__chip--outline">Free shipping</span>{%- endif -%}
                              {%- if per_day > 0 -%}<span class="nl-tier__chip">Just {{ per_day | money }}/day</span>{%- endif -%}
                              {%- if save > 0 -%}<span class="nl-tier__save">Save {{ save | money_without_trailing_zeros }}</span>{%- endif -%}
                            </span>
                          {%- endif -%}
                        </span>
                        <span class="nl-option-card__price nl-tier__price">
                          {%- if units > 1 -%}
                            <strong>{{ per_unit | money }}<small>/each</small></strong>
                            <span class="nl-tier__total">{{ variant.price | money }} total</span>
                          {%- else -%}
                            <strong>{{ variant.price | money }}</strong>
                          {%- endif -%}
                          {%- if variant.compare_at_price > variant.price -%}
                            <s>{{ variant.compare_at_price | money }}</s>
                          {%- endif -%}
                        </span>
                      </span>
                      {%- if ribbon != blank -%}
                        <span class="nl-tier__ribbon">{{ ribbon | escape }}</span>
                      {%- endif -%}
                    </label>
                  {%- endfor -%}
                </fieldset>
              {%- endif -%}

              {%- if tier_mode and tier_live -%}
                {%- liquid
                  assign offer_index = -1
                  assign offer_discount = 0
                  assign base_tier = 0
                  assign base_found = false
                  for tier in tier_blocks
                    if tier.settings.discount == 0 and base_found == false
                      assign base_tier = forloop.index0
                      assign base_found = true
                    endif
                    if tier.settings.discount > offer_discount
                      assign offer_discount = tier.settings.discount
                      assign offer_index = forloop.index0
                    endif
                  endfor
                  assign offer_name = ''
                  assign offer_free = false
                  if offer_discount > 0 and offer_index != base_tier
                    assign offer_tier = tier_blocks[offer_index]
                    assign offer_qty = offer_tier.settings.quantity | at_least: 1
                    assign offer_unit = section.settings.unit_plural | default: 'bags'
                    if offer_qty == 1
                      assign offer_unit = section.settings.unit_singular | default: 'bag'
                    endif
                    assign offer_name = offer_tier.settings.title
                    if offer_name == blank
                      assign offer_name = offer_qty | append: ' ' | append: offer_unit
                    endif
                    capture offer_math
                      render 'nurellea-bundle-math', price: current_variant.price, qty: offer_qty, discount: offer_discount, days: 0, live: tier_live
                    endcapture
                    assign offer_parts = offer_math | strip | split: '|'
                    assign offer_total = offer_parts[0] | plus: 0
                    assign free_ship_cents = settings.free_shipping_threshold | plus: 0 | times: 100
                    if free_ship_cents > 0 and offer_total >= free_ship_cents
                      assign offer_free = true
                    endif
                  endif
                -%}
                {%- if offer_discount > 0 and offer_index != base_tier -%}
                  <label class="nl-offer">
                    <input
                      type="checkbox"
                      data-nl-offer-input
                      data-nl-offer-on="{{ offer_index }}"
                      data-nl-offer-off="{{ base_tier }}"
                      {% if selected_tier == offer_index %}checked{% endif %}
                    >
                    <span class="nl-offer__box">
                      <span class="nl-offer__check" aria-hidden="true"></span>
                      <span class="nl-offer__copy">
                        <span class="nl-offer__title">Save {{ offer_discount }}% on {{ offer_name | escape }}</span>
                        <span class="nl-offer__sub" data-nl-offer-sub data-guarantee="{{ settings.guarantee_text | escape }}">
                          {%- if offer_free -%}Free shipping{% if settings.guarantee_text != blank %} · {% endif %}{%- endif -%}
                          {%- if settings.guarantee_text != blank -%}{{ settings.guarantee_text | escape }}{%- endif -%}
                        </span>
                      </span>
                    </span>
                  </label>
                {%- endif -%}
              {%- endif -%}

              {%- if subscriptions_on -%}
                <fieldset class="nl-options">
                  <legend class="nl-options__legend"><span>Purchase option</span></legend>
                  {%- unless p.requires_selling_plan -%}
                    <label class="nl-option-card">
                      <input type="radio" name="nl-plan-{{ section.id }}" value="" data-nl-plan-input {% unless selected_plan %}checked{% endunless %}>
                      <span class="nl-option-card__body">
                        <span class="nl-option-card__radio" aria-hidden="true"></span>
                        <span class="nl-option-card__title">One-time purchase</span>
                        <span class="nl-option-card__price"><strong data-nl-plan-price="">{{ current_variant.price | money }}</strong></span>
                      </span>
                    </label>
                  {%- endunless -%}
                  {%- for group in p.selling_plan_groups -%}
                    {%- for plan in group.selling_plans -%}
                      {%- assign plan_alloc = nil -%}
                      {%- for a in current_variant.selling_plan_allocations -%}
                        {%- if a.selling_plan.id == plan.id -%}{%- assign plan_alloc = a -%}{%- endif -%}
                      {%- endfor -%}
                      <label class="nl-option-card">
                        <input type="radio" name="nl-plan-{{ section.id }}" value="{{ plan.id }}" data-nl-plan-input {% if selected_plan.id == plan.id %}checked{% endif %}>
                        <span class="nl-option-card__body">
                          <span class="nl-option-card__radio" aria-hidden="true"></span>
                          <span>
                            <span class="nl-option-card__title">{{ plan.name | escape }}</span>
                            {%- if plan.description != blank -%}<span class="nl-option-card__sub">{{ plan.description | escape }}</span>{%- endif -%}
                          </span>
                          <span class="nl-option-card__price">
                            {%- if plan_alloc -%}<strong data-nl-plan-price="{{ plan.id }}">{{ plan_alloc.price | money }}</strong>{%- endif -%}
                          </span>
                        </span>
                      </label>
                    {%- endfor -%}
                  {%- endfor -%}
                  {%- if settings.subscription_portal_url != blank -%}
                    <p class="nl-small nl-muted">Manage or cancel subscriptions any time from <a href="{{ settings.subscription_portal_url }}">your subscription portal</a>.</p>
                  {%- endif -%}
                </fieldset>
              {%- elsif p.requires_selling_plan and request.design_mode -%}
                <p class="nl-setup-note">This product requires a selling plan, but subscriptions are disabled in Theme settings. Shoppers will not be able to add it to the cart.</p>
              {%- endif -%}

              <div class="nl-stack nl-stack--sm" data-nl-buy-area>
                <span class="nl-stock" data-nl-stock data-available="{{ current_variant.available }}">
                  {%- if current_variant.available -%}In stock{%- else -%}Sold out{%- endif -%}
                </span>
                <span class="product-form-text__error hidden" ref="addToCartTextError">
                  <span class="svg-wrapper">{{- 'icon-error.svg' | inline_asset_content -}}</span>
                </span>
                <div class="nl-buy-row">
                  {%- if tier_mode -%}
                    <input type="hidden" name="quantity" value="{{ tier_blocks[selected_tier].settings.quantity | at_least: 1 }}" data-nl-tier-qty>
                  {%- elsif section.settings.show_quantity -%}
                    <div class="nl-qty" data-nl-qty>
                      <button type="button" data-nl-qty-minus aria-label="Decrease quantity">{% render 'nurellea-icon', name: 'minus' %}</button>
                      <label class="visually-hidden" for="Quantity-{{ section.id }}">Quantity</label>
                      <input
                        id="Quantity-{{ section.id }}"
                        type="number"
                        name="quantity"
                        inputmode="numeric"
                        value="{{ current_variant.quantity_rule.min | default: 1 }}"
                        min="{{ current_variant.quantity_rule.min | default: 1 }}"
                        step="{{ current_variant.quantity_rule.increment | default: 1 }}"
                        {% if current_variant.quantity_rule.max != null %}max="{{ current_variant.quantity_rule.max }}"{% endif %}
                      >
                      <button type="button" data-nl-qty-plus aria-label="Increase quantity">{% render 'nurellea-icon', name: 'plus' %}</button>
                    </div>
                  {%- else -%}
                    <input type="hidden" name="quantity" value="{{ current_variant.quantity_rule.min | default: 1 }}">
                  {%- endif -%}
                  <div{% if tier_mode or section.settings.show_quantity == false %} style="grid-column: 1 / -1"{% endif %}>
                    {%- liquid
                      assign atc_label = 'Add to cart'
                      unless current_variant.available
                        assign atc_label = 'Sold out'
                      endunless
                      assign atc_id = 'AddToCart-' | append: section.id
                    -%}
                    {% render 'add-to-cart-button',
                      can_add_to_cart: current_variant.available,
                      add_to_cart_text: atc_label,
                      product: p,
                      class: 'nl-btn nl-atc',
                      id: atc_id
                    %}
                  </div>
                </div>
                {%- if section.settings.show_dynamic_checkout -%}
                  <div ref="acceleratedCheckoutButtonContainer">{{ form | payment_button }}</div>
                {%- endif -%}
              </div>
            </div>
          {%- endform -%}
        </product-form-component>

        {%- if settings.shipping_eta != blank or settings.guarantee_text != blank -%}
          <div class="nl-pdp__eta">
            {%- if settings.shipping_eta != blank -%}
              <span>{% render 'nurellea-icon', name: 'package' %}<strong>{{ settings.shipping_eta | escape }}</strong></span>
            {%- endif -%}
            {%- if settings.guarantee_text != blank -%}
              <span>{% render 'nurellea-icon', name: 'shield' %}{{ settings.guarantee_text | escape }}</span>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if settings.free_shipping_threshold > 0 -%}
          {%- liquid
            assign threshold_cents = settings.free_shipping_threshold | times: 100
            assign free_qty = 0
            if tier_mode
              for tier in tier_blocks
                capture tmath
                  render 'nurellea-bundle-math', price: current_variant.price, qty: tier.settings.quantity, discount: tier.settings.discount, days: 0, live: tier_live
                endcapture
                assign tier_total = tmath | strip | split: '|' | first | plus: 0
                if tier_total >= threshold_cents
                  assign free_qty = tier.settings.quantity
                  break
                endif
              endfor
            endif
          -%}
          <p class="nl-alert nl-alert--info nl-small">
            {% render 'nurellea-icon', name: 'truck' %}
            <span>
              {%- if free_qty > 1 -%}
                <strong>Free shipping on {{ free_qty }}+ {{ section.settings.unit_plural | default: 'bags' | escape }}</strong> (orders over {{ threshold_cents | money_without_trailing_zeros }}). Shipping for 1 {{ section.settings.unit_singular | default: 'bag' | escape }} is shown at checkout.
              {%- else -%}
                Free shipping on orders over {{ threshold_cents | money_without_trailing_zeros }}.
              {%- endif -%}
            </span>
          </p>
        {%- endif -%}

        {%- assign assurance_blocks = section.blocks | where: 'type', 'assurance' -%}
        {%- if assurance_blocks.size > 0 -%}
          <div class="nl-pdp__assurances">
            {%- for block in assurance_blocks -%}
              <div class="nl-pdp__assurance" {{ block.shopify_attributes }}>
                {% render 'nurellea-icon', name: block.settings.icon %}
                <span>
                  {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{{ block.settings.text | escape }}</a>{%- else -%}{{ block.settings.text | escape }}{%- endif -%}
                </span>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- for block in section.blocks -%}
          {%- if block.type == '@app' -%}
            <div {{ block.shopify_attributes }}>{% render block %}</div>
          {%- endif -%}
        {%- endfor -%}

        {%- comment -%} ——— Product facts ——— {%- endcomment -%}
        <div class="nl-accordion">
          {%- if p.description != blank -%}
            <details class="nl-accordion__item" {% if section.settings.open_description %}open{% endif %}>
              <summary><span class="nl-accordion__summary-label">{% render 'nurellea-icon', name: 'sparkle' %}About this product</span><span class="nl-accordion__icon" aria-hidden="true"></span></summary>
              <div class="nl-accordion__body nl-prose">{{ p.description }}</div>
            </details>
          {%- endif -%}

          {%- liquid
            assign other_ingredients = settings.facts_other_ingredients
            if mf.ingredients_text != blank
              assign other_ingredients = ''
            endif
            assign allergens_fallback = settings.facts_allergens
            if mf.allergens != blank
              assign allergens_fallback = ''
            endif
          -%}
          {%- if mf.ingredients.value.size > 0 or mf.ingredients_text != blank or other_ingredients != blank -%}
            <details class="nl-accordion__item" id="ingredients">
              <summary><span class="nl-accordion__summary-label">{% render 'nurellea-icon', name: 'leaf' %}Ingredients</span><span class="nl-accordion__icon" aria-hidden="true"></span></summary>
              <div class="nl-accordion__body nl-prose">
                {%- if mf.ingredients.value.size > 0 -%}
                  <ul>
                    {%- for ing in mf.ingredients.value -%}
                      <li><strong>{{ ing.name.value | escape }}</strong>{% if ing.amount != blank %} — {{ ing.amount.value | escape }}{% endif %}{% if ing.summary != blank %}<br><span class="nl-muted">{{ ing.summary.value | escape }}</span>{% endif %}</li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
                {%- if mf.ingredients.value.size == 0 and mf.ingredients_text == blank and settings.facts_rows != blank -%}
                  <p><strong>Active ingredients{% if settings.facts_serving_size != blank %} (per {{ settings.facts_serving_size | escape }}){% endif %}:</strong></p>
                  <ul>
                    {%- assign fact_lines = settings.facts_rows | strip | newline_to_br | split: '<br />' -%}
                    {%- for line in fact_lines -%}
                      {%- assign cells = line | split: '|' -%}
                      {%- assign cell_name = cells[0] | strip -%}
                      {%- if cell_name != blank -%}
                        <li>{{ cell_name | escape }}{% assign cell_amount = cells[1] | strip %}{% if cell_amount != blank %} — {{ cell_amount | escape }}{% endif %}</li>
                      {%- endif -%}
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
                {%- if mf.ingredients_text != blank -%}
                  <p><strong>Full ingredient list:</strong></p>
                  {% render 'nurellea-rich', field: mf.ingredients_text %}
                {%- elsif other_ingredients != blank -%}
                  <p><strong>Other ingredients:</strong></p>
                  {% render 'nurellea-text', text: other_ingredients %}
                {%- endif -%}
                {%- if mf.allergens != blank -%}
                  <p><strong>Allergen information:</strong></p>
                  {% render 'nurellea-rich', field: mf.allergens %}
                {%- elsif allergens_fallback != blank -%}
                  <p><strong>Allergen information:</strong></p>
                  {% render 'nurellea-text', text: allergens_fallback %}
                {%- endif -%}
              </div>
            </details>
          {%- elsif request.design_mode -%}
            <p class="nl-setup-note">Ingredients: fill Theme settings &gt; Nurellea product facts, or add <code>nurellea.ingredients</code> / <code>nurellea.ingredients_text</code> (full list exactly as on the label).</p>
          {%- endif -%}

          {%- capture facts_html -%}{% render 'nurellea-supplement-facts', product: p %}{%- endcapture -%}
          {%- if facts_html != blank -%}
            <details class="nl-accordion__item" id="supplement-facts">
              <summary><span class="nl-accordion__summary-label">{% render 'nurellea-icon', name: 'list' %}Supplement facts</span><span class="nl-accordion__icon" aria-hidden="true"></span></summary>
              <div class="nl-accordion__body">{{ facts_html }}</div>
            </details>
          {%- endif -%}

          {%- assign serving_size_text = mf.serving_size.value | default: settings.facts_serving_size -%}
          {%- if mf.directions != blank or serving_size_text != blank or settings.facts_directions != blank -%}
            <details class="nl-accordion__item" id="how-to-use">
              <summary><span class="nl-accordion__summary-label">{% render 'nurellea-icon', name: 'calendar' %}How to use</span><span class="nl-accordion__icon" aria-hidden="true"></span></summary>
              <div class="nl-accordion__body nl-prose">
                {%- if serving_size_text != blank -%}<p><strong>Serving size:</strong> {{ serving_size_text | escape }}</p>{%- endif -%}
                {%- if mf.directions != blank -%}
                  {% render 'nurellea-rich', field: mf.directions %}
                {%- else -%}
                  {% render 'nurellea-text', text: settings.facts_directions %}
                {%- endif -%}
                {%- if mf.storage != blank -%}
                  <p><strong>Storage:</strong></p>{% render 'nurellea-rich', field: mf.storage %}
                {%- elsif settings.facts_storage != blank -%}
                  <p><strong>Storage:</strong></p>{% render 'nurellea-text', text: settings.facts_storage %}
                {%- endif -%}
              </div>
            </details>
          {%- elsif request.design_mode -%}
            <p class="nl-setup-note">How to use: fill the directions in Theme settings &gt; Nurellea product facts, or add <code>nurellea.directions</code> from the approved label.</p>
          {%- endif -%}

          {%- if mf.warnings != blank or settings.facts_warnings != blank -%}
            <details class="nl-accordion__item" id="warnings">
              <summary><span class="nl-accordion__summary-label">{% render 'nurellea-icon', name: 'info' %}Warnings &amp; safety</span><span class="nl-accordion__icon" aria-hidden="true"></span></summary>
              <div class="nl-accordion__body nl-prose">
                {%- if mf.warnings != blank -%}
                  {% render 'nurellea-rich', field: mf.warnings %}
                {%- else -%}
                  {% render 'nurellea-text', text: settings.facts_warnings %}
                {%- endif -%}
              </div>
            </details>
          {%- elsif request.design_mode -%}
            <p class="nl-setup-note">Warnings: fill Theme settings &gt; Nurellea product facts &gt; Warnings exactly as printed on the label.</p>
          {%- endif -%}

          <details class="nl-accordion__item" id="shipping-returns">
            <summary><span class="nl-accordion__summary-label">{% render 'nurellea-icon', name: 'truck' %}Shipping &amp; returns</span><span class="nl-accordion__icon" aria-hidden="true"></span></summary>
            <div class="nl-accordion__body nl-prose">
              {%- if settings.shipping_summary != blank -%}<p>{{ settings.shipping_summary | escape }}</p>{%- endif -%}
              {%- if settings.guarantee_text != blank -%}<p>{{ settings.guarantee_text | escape }}</p>{%- endif -%}
              <p>
                {%- if shop.shipping_policy.body != blank -%}<a href="{{ shop.shipping_policy.url }}">Shipping policy</a>{%- endif -%}
                {%- if shop.shipping_policy.body != blank and shop.refund_policy.body != blank %} · {% endif -%}
                {%- if shop.refund_policy.body != blank -%}<a href="{{ shop.refund_policy.url }}">Returns &amp; refunds</a>{%- endif -%}
              </p>
              {%- if shop.shipping_policy.body == blank and shop.refund_policy.body == blank and settings.shipping_summary == blank -%}
                <p>Shipping options and costs are shown at checkout. <a href="{{ routes.root_url }}pages/contact">Contact us</a> with any questions.</p>
              {%- endif -%}
            </div>
          </details>

          {%- for block in section.blocks -%}
            {%- if block.type == 'accordion' and block.settings.title != blank -%}
              <details class="nl-accordion__item" {{ block.shopify_attributes }}>
                <summary><span class="nl-accordion__summary-label">{% render 'nurellea-icon', name: block.settings.icon %}{{ block.settings.title | escape }}</span><span class="nl-accordion__icon" aria-hidden="true"></span></summary>
                <div class="nl-accordion__body nl-prose">
                  {{ block.settings.content }}
                  {%- if block.settings.page != blank -%}{{ block.settings.page.content }}{%- endif -%}
                </div>
              </details>
            {%- endif -%}
          {%- endfor -%}
        </div>

        {%- if settings.supplement_disclaimer != blank and section.settings.show_disclaimer -%}
          <p class="nl-small nl-muted">{{ settings.supplement_disclaimer | escape }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>

  {%- if section.settings.show_sticky_bar -%}
    <div class="nl-sticky-atc" data-nl-sticky-atc aria-hidden="true">
      <div class="nl-sticky-atc__inner">
        <div class="nl-sticky-atc__media">
          {%- if p.featured_media -%}
            {{ p.featured_media.preview_image | image_url: width: 120 | image_tag: loading: 'lazy', alt: '', width: 48, height: 48 }}
          {%- endif -%}
        </div>
        <div class="nl-sticky-atc__text">
          <span class="nl-sticky-atc__title">{{ p.title | escape }}</span>
          <span class="nl-sticky-atc__price">
            <span data-nl-price>{{ display_price | money }}</span>
            {%- liquid
              assign sticky_label = ''
              unless p.has_only_default_variant
                assign sticky_label = current_variant.title
              endunless
              if tier_mode
                assign sticky_qty = tier_blocks[selected_tier].settings.quantity | at_least: 1
                assign sticky_tier = tier_blocks[selected_tier].settings.title
                if sticky_tier == blank
                  if sticky_qty == 1
                    assign sticky_tier = '1 ' | append: section.settings.unit_singular
                  else
                    assign sticky_tier = sticky_qty | append: ' ' | append: section.settings.unit_plural
                  endif
                endif
                if sticky_label != blank
                  assign sticky_label = sticky_label | append: ' · ' | append: sticky_tier
                else
                  assign sticky_label = sticky_tier
                endif
              endif
            -%}
            <span class="nl-sticky-atc__variant nl-muted" data-nl-variant-title {% if sticky_label == blank %}hidden{% endif %}>{{ sticky_label | escape }}</span>
          </span>
        </div>
        <button type="button" class="button nl-btn" data-nl-sticky-submit tabindex="-1" {% unless current_variant.available %}disabled{% endunless %}>
          <span data-nl-atc-label>{% if current_variant.available %}Add to cart{% else %}Sold out{% endif %}</span>
        </button>
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} Variant data for client-side price/stock updates. Money strings are formatted by Shopify. {%- endcomment -%}
  <script type="application/json" data-nl-product-json>
    {
      "strings": {
        "add_to_cart": "Add to cart",
        "sold_out": "Sold out",
        "in_stock": "In stock",
        "save": "Save",
        "per_day": "Just [amount]/day",
        "free_shipping": "Free shipping"
      },
      "variants": [
        {%- for variant in p.variants -%}
          {
            "id": {{ variant.id }},
            "title": {{ variant.title | json }},
            "available": {{ variant.available | json }},
            "price_cents": {{ variant.price }},
            "price": {{ variant.price | money | json }},
            "compare_at": {% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | json }}{% else %}null{% endif %},
            "savings": {% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | minus: variant.price | money | json }}{% else %}null{% endif %},
            "unit_price": {% if variant.unit_price_measurement %}{% capture up %}{{ variant.unit_price | money }}/{% if variant.unit_price_measurement.reference_value != 1 %}{{ variant.unit_price_measurement.reference_value }}{% endif %}{{ variant.unit_price_measurement.reference_unit }}{% endcapture %}{{ up | strip | json }}{% else %}null{% endif %},
            "featured_media_id": {% if variant.featured_media %}{{ variant.featured_media.id }}{% else %}null{% endif %},
            "tiers": [
              {%- if tier_mode -%}
                {%- for tier in tier_blocks -%}
                  {%- liquid
                    capture tier_math
                      render 'nurellea-bundle-math', price: variant.price, qty: tier.settings.quantity, discount: tier.settings.discount, days: supply_days, live: tier_live
                    endcapture
                    assign tier_math = tier_math | strip | split: '|'
                    assign t_total = tier_math[0] | plus: 0
                    assign t_full = tier_math[1] | plus: 0
                    assign t_each = tier_math[2] | plus: 0
                    assign t_per_day = tier_math[3] | plus: 0
                    assign t_save = tier_math[4] | plus: 0
                    assign free_ship_cents = settings.free_shipping_threshold | plus: 0 | times: 100
                  -%}
                  {
                    "total": {{ t_total | money | json }},
                    "full": {% if t_save > 0 %}{{ t_full | money | json }}{% else %}null{% endif %},
                    "each": {{ t_each | money | json }},
                    "each_cents": {{ t_each }},
                    "per_day": {% if t_per_day > 0 %}{{ t_per_day | money | json }}{% else %}null{% endif %},
                    "save": {% if t_save > 0 %}{{ t_save | money | json }}{% else %}null{% endif %},
                    "free_shipping": {% if free_ship_cents > 0 and t_total >= free_ship_cents %}true{% else %}false{% endif %}
                  }{% unless forloop.last %},{% endunless %}
                {%- endfor -%}
              {%- endif -%}
            ],
            "plans": {
              {%- if subscriptions_on -%}
                {%- for a in variant.selling_plan_allocations -%}
                  "{{ a.selling_plan.id }}": {
                    "price": {{ a.price | money | json }},
                    "compare_at": {% if a.compare_at_price > a.price %}{{ a.compare_at_price | money | json }}{% else %}null{% endif %},
                    "savings": {% if a.compare_at_price > a.price %}{{ a.compare_at_price | minus: a.price | money | json }}{% else %}null{% endif %}
                  }{% unless forloop.last %},{% endunless %}
                {%- endfor -%}
              {%- endif -%}
            }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>

  {%- comment -%} Product structured data — prices/stock from Shopify, rating only from genuine published reviews. {%- endcomment -%}
  {%- if template.name == 'product' -%}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Product",
        "@id": {{ shop.url | append: p.url | append: '#product' | json }},
        "name": {{ p.title | json }},
        "url": {{ shop.url | append: p.url | json }},
        {%- if p.description != blank %}"description": {{ p.description | strip_html | strip_newlines | truncate: 500 | json }},{% endif %}
        {%- if p.media.size > 0 %}
        "image": [
          {%- for media in p.media limit: 6 -%}
            {{ media.preview_image | image_url: width: 1600 | prepend: 'https:' | json }}{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ],
        {%- endif %}
        "brand": { "@type": "Brand", "name": {{ p.vendor | default: shop.name | json }} },
        {%- if current_variant.sku != blank %}"sku": {{ current_variant.sku | json }},{% endif %}
        {%- assign barcode_len = current_variant.barcode | size -%}
        {%- if barcode_len == 8 or barcode_len == 12 or barcode_len == 13 or barcode_len == 14 %}"gtin": {{ current_variant.barcode | json }},{% endif %}
        {%- if review_count > 0 %}
        "aggregateRating": {
          "@type": "AggregateRating",
          "ratingValue": {{ review_avg | json }},
          "reviewCount": {{ review_count | json }},
          "bestRating": 5,
          "worstRating": 1
        },
        {%- endif %}
        "offers": [
          {%- for variant in p.variants -%}
            {
              "@type": "Offer",
              {%- if variant.sku != blank %}"sku": {{ variant.sku | json }},{% endif %}
              "name": {{ variant.title | json }},
              "price": {{ variant.price | divided_by: 100.0 | json }},
              "priceCurrency": {{ cart.currency.iso_code | json }},
              "availability": "https://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
              "itemCondition": "https://schema.org/NewCondition",
              "url": {{ shop.url | append: variant.url | json }},
              "seller": { "@type": "Organization", "name": {{ shop.name | json }} }
            }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
      }
    </script>
  {%- endif -%}
</section>
{%- endif -%}

{% schema %}
{
  "name": "Nurellea product",
  "tag": "div",
  "class": "nl-main-product-section",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "info": "Used outside product pages. On product pages the current product is always used."
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "checkbox", "id": "show_breadcrumbs", "label": "Show breadcrumbs", "default": true },
    { "type": "header", "content": "Trustpilot" },
    { "type": "checkbox", "id": "show_trustpilot", "label": "Show Trustpilot under the product title", "default": true },
    { "type": "text", "id": "trustpilot_score", "label": "Score line", "default": "4.6 from 10,561+ reviews" },
    { "type": "url", "id": "trustpilot_link", "label": "Trustpilot link" },
    { "type": "header", "content": "Gallery" },
    { "type": "checkbox", "id": "show_lifestyle", "label": "Show an in-use photo after the product images", "default": true },
    { "type": "image_picker", "id": "lifestyle_image", "label": "In-use photo", "info": "Shown after the product photos. Leave blank to use the gummy-in-hand photo." },
    { "type": "header", "content": "Bundle options" },
    { "type": "paragraph", "content": "Add \"Bundle option\" blocks (e.g. 1 bag, 2 bags −10%, 3 bags −15%). Each option adds that many bags to the cart. Without bundle blocks, each variant shows as a supply card instead." },
    { "type": "text", "id": "variant_heading", "label": "Heading", "default": "Choose your supply" },
    {
      "type": "range",
      "id": "default_variant_position",
      "label": "Pre-selected option",
      "info": "Position of the option selected when the page loads.",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "bundle_discounts_live",
      "label": "Bundle discounts are active",
      "default": false,
      "info": "Tick only after creating the matching automatic discounts in Shopify admin > Discounts. Until then every option shows the full price."
    },
    { "type": "text", "id": "unit_singular", "label": "Unit name", "default": "bag" },
    { "type": "text", "id": "unit_plural", "label": "Unit name (plural)", "default": "bags" },
    {
      "type": "number",
      "id": "supply_days_per_unit",
      "label": "Days of supply per bag",
      "info": "From the label (servings per bag ÷ servings per day). Shows \"Just $X/day\" and \"60-day supply\". Leave blank to hide."
    },
    { "type": "checkbox", "id": "show_best_value", "label": "Label the biggest saving", "default": true },
    { "type": "text", "id": "best_value_label", "label": "Biggest saving label", "default": "Best value" },
    { "type": "header", "content": "Buy box" },
    { "type": "checkbox", "id": "show_quantity", "label": "Show quantity selector", "default": true },
    { "type": "checkbox", "id": "show_short_description", "label": "Show short description above buy box", "default": false },
    { "type": "checkbox", "id": "open_description", "label": "Open description by default", "default": true },
    {
      "type": "checkbox",
      "id": "show_dynamic_checkout",
      "label": "Show dynamic checkout buttons",
      "info": "Buy-now buttons are routed by the checkout integration when it is enabled.",
      "default": false
    },
    { "type": "checkbox", "id": "show_sticky_bar", "label": "Show sticky add-to-cart bar", "default": true },
    { "type": "checkbox", "id": "show_disclaimer", "label": "Show supplement disclaimer", "default": true }
  ],
  "blocks": [
    { "type": "@app" },
    {
      "type": "bundle_tier",
      "name": "Bundle option",
      "limit": 4,
      "settings": [
        { "type": "range", "id": "quantity", "label": "Bags", "min": 1, "max": 12, "step": 1, "default": 1 },
        {
          "type": "range",
          "id": "discount",
          "label": "Discount",
          "unit": "%",
          "min": 0,
          "max": 50,
          "step": 1,
          "default": 0,
          "info": "Must match the automatic discount in Shopify for this many bags."
        },
        { "type": "text", "id": "title", "label": "Title", "info": "Leave blank for \"2 bags\"." },
        { "type": "text", "id": "subtitle", "label": "Subtitle", "info": "Leave blank for \"60-day supply\" (needs days of supply)." },
        { "type": "text", "id": "badge", "label": "Ribbon", "info": "Replaces the automatic best-value label. Only use claims you can back up." }
      ]
    },
    {
      "type": "assurance",
      "name": "Assurance",
      "limit": 3,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "lock",
          "options": [
            { "value": "lock", "label": "Lock" },
            { "value": "truck", "label": "Truck" },
            { "value": "return", "label": "Return" },
            { "value": "shield", "label": "Shield" },
            { "value": "package", "label": "Package" },
            { "value": "chat", "label": "Chat" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "heart", "label": "Heart" }
          ]
        },
        { "type": "text", "id": "text", "label": "Text", "default": "Secure checkout" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    },
    {
      "type": "accordion",
      "name": "Extra accordion",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "info",
          "options": [
            { "value": "info", "label": "Info" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "heart", "label": "Heart" },
            { "value": "flask", "label": "Flask" },
            { "value": "package", "label": "Package" }
          ]
        },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "richtext", "id": "content", "label": "Content" },
        { "type": "page", "id": "page", "label": "Or show page content" }
      ]
    }
  ]
}
{% endschema %}
