{%- liquid
  assign p = section.settings.product | default: product | default: settings.nurellea_product
  assign source = 'blocks'
  assign entries = nil
  if section.settings.source == 'product' and p.metafields.nurellea.faqs.value.size > 0
    assign entries = p.metafields.nurellea.faqs.value
    assign source = 'entries'
  elsif section.settings.source == 'store' and shop.metaobjects.nurellea_faq.values.size > 0
    assign entries = shop.metaobjects.nurellea_faq.values
    assign source = 'entries'
  endif

  assign categories = ''
  if source == 'entries'
    for e in entries
      if e.category != blank
        assign categories = categories | append: e.category.value | append: '|'
      endif
    endfor
  else
    for block in section.blocks
      if block.settings.category != blank
        assign categories = categories | append: block.settings.category | append: '|'
      endif
    endfor
  endif
  assign categories = categories | split: '|' | uniq
-%}
<section class="nl-section color-{{ section.settings.color_scheme }}" id="faq" aria-labelledby="Faq-{{ section.id }}">
  <div class="nl-container{% if section.settings.layout == 'stacked' %} nl-container--narrow{% endif %}">
    <div class="{% if section.settings.layout == 'split' %}nl-split{% else %}nl-stack nl-stack--lg{% endif %}" style="align-items: start;">
      <header class="nl-stack" {% if section.settings.layout == 'split' %}style="position: sticky; top: 120px;"{% endif %} data-nl-reveal>
        {%- if section.settings.eyebrow != blank -%}<p class="nl-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2 id="Faq-{{ section.id }}" class="nl-h2">
          {{ section.settings.heading | escape }}
          {%- if section.settings.heading_accent != blank %} <em class="nl-accent">{{ section.settings.heading_accent | escape }}</em>{%- endif -%}
        </h2>
        {%- if section.settings.text != blank -%}<div class="nl-lead nl-muted">{{ section.settings.text }}</div>{%- endif -%}
        {%- if section.settings.contact_label != blank -%}
          <div><a class="nl-link" href="{{ section.settings.contact_link | default: '/pages/contact' }}">{{ section.settings.contact_label | escape }} {% render 'nurellea-icon', name: 'arrow-right' %}</a></div>
        {%- endif -%}
      </header>

      <div data-nl-faq>
        {%- if section.settings.show_search -%}
          <div class="nl-toolbar">
            <label class="visually-hidden" for="FaqSearch-{{ section.id }}">Search questions</label>
            <input id="FaqSearch-{{ section.id }}" class="nl-search-input" type="search" placeholder="Search questions" data-nl-faq-search autocomplete="off">
            {%- if categories.size > 1 -%}
              <div class="nl-filter-group" role="group" aria-label="Filter by topic">
                <button type="button" class="nl-filter" data-nl-faq-cat="all" aria-pressed="true">All</button>
                {%- for c in categories -%}
                  <button type="button" class="nl-filter" data-nl-faq-cat="{{ c | handleize }}" aria-pressed="false">{{ c | escape }}</button>
                {%- endfor -%}
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}

        <div class="nl-accordion{% if section.settings.card_style %} nl-accordion--card{% endif %}">
          {%- if source == 'entries' -%}
            {%- for e in entries -%}
              <details class="nl-accordion__item" data-nl-faq-item data-category="{{ e.category.value | handleize }}">
                <summary>{{ e.question.value | escape }}<span class="nl-accordion__icon" aria-hidden="true"></span></summary>
                <div class="nl-accordion__body nl-prose">{% render 'nurellea-rich', field: e.answer %}</div>
              </details>
            {%- endfor -%}
          {%- else -%}
            {%- for block in section.blocks -%}
              <details class="nl-accordion__item" data-nl-faq-item data-category="{{ block.settings.category | handleize }}" {% if forloop.first and section.settings.open_first %}open{% endif %} {{ block.shopify_attributes }}>
                <summary>{{ block.settings.question | escape }}<span class="nl-accordion__icon" aria-hidden="true"></span></summary>
                <div class="nl-accordion__body nl-prose">{{ block.settings.answer }}</div>
              </details>
            {%- endfor -%}
          {%- endif -%}
        </div>
        <p class="nl-empty" data-nl-faq-empty hidden style="margin-top: 16px;">No questions match your search. <a class="nl-link" href="/pages/contact">Ask us directly</a></p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Nurellea FAQ",
  "tag": "div",
  "settings": [
    {
      "type": "select",
      "id": "source",
      "label": "Questions source",
      "default": "blocks",
      "info": "Product: metafield nurellea.faqs. Store: all published \"Nurellea FAQ\" entries. Falls back to blocks when empty.",
      "options": [
        { "value": "blocks", "label": "Blocks below" },
        { "value": "product", "label": "Product FAQ metafield" },
        { "value": "store", "label": "All FAQ entries" }
      ]
    },
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "default": "split",
      "options": [
        { "value": "split", "label": "Heading beside questions" },
        { "value": "stacked", "label": "Stacked" }
      ]
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "FAQ" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions," },
    { "type": "text", "id": "heading_accent", "label": "Heading accent (italic)", "default": "answered" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "contact_label", "label": "Contact link label", "default": "Still have a question? Contact us" },
    { "type": "url", "id": "contact_link", "label": "Contact link" },
    { "type": "checkbox", "id": "show_search", "label": "Show search & topic filter", "default": false },
    { "type": "checkbox", "id": "card_style", "label": "Card style", "default": false },
    { "type": "checkbox", "id": "open_first", "label": "Open first question", "default": false }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Question" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Answer</p>" },
        { "type": "text", "id": "category", "label": "Topic", "info": "Used by the topic filter, e.g. Orders, Product, Shipping." }
      ]
    }
  ],
  "presets": [{ "name": "Nurellea FAQ" }]
}
{% endschema %}
