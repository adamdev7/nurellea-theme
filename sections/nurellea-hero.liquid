{%- liquid
  assign p = section.settings.product | default: settings.nurellea_product
  assign primary_link = section.settings.button_link | default: p.url | default: routes.all_products_collection_url
-%}
<section class="nl-section nl-hero color-{{ section.settings.color_scheme }}" aria-labelledby="Hero-{{ section.id }}">
  <span class="nl-orb" style="inline-size: 520px; block-size: 520px; inset-inline-end: -160px; inset-block-start: -140px; --nl-orb-opacity: .55;" aria-hidden="true"></span>
  <span class="nl-orb" style="inline-size: 300px; block-size: 300px; inset-inline-start: -120px; inset-block-end: -80px; --nl-orb-color: #fff; --nl-orb-opacity: .8;" aria-hidden="true"></span>
  <div class="nl-container">
    <div class="nl-hero__grid">
      <div class="nl-hero__content">
        {%- if section.settings.eyebrow != blank -%}<p class="nl-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h1 id="Hero-{{ section.id }}" class="nl-h1">
          {{ section.settings.heading | escape }}
          {%- if section.settings.heading_accent != blank %} <em class="nl-accent">{{ section.settings.heading_accent | escape }}</em>{%- endif -%}
        </h1>
        {%- if section.settings.text != blank -%}<div class="nl-lead">{{ section.settings.text }}</div>{%- endif -%}
        <div class="nl-actions nl-hero__actions">
          {%- if section.settings.button_label != blank -%}
            <a class="button nl-btn nl-btn--lg" href="{{ primary_link }}">
              {{ section.settings.button_label | escape }} {% render 'nurellea-icon', name: 'arrow-right' %}
            </a>
          {%- endif -%}
          {%- if section.settings.button2_label != blank and section.settings.button2_link != blank -%}
            <a class="button-secondary nl-btn nl-btn--lg" href="{{ section.settings.button2_link }}">{{ section.settings.button2_label | escape }}</a>
          {%- endif -%}
        </div>
        {%- if section.blocks.size > 0 -%}
          <ul class="nl-hero__meta" role="list" style="list-style:none;margin:0;padding:0;">
            {%- for block in section.blocks -%}
              <li class="nl-hero__meta-item" {{ block.shopify_attributes }}>{% render 'nurellea-icon', name: block.settings.icon %}{{ block.settings.text | escape }}</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      <div class="nl-hero__visual">
        {%- liquid
          assign use_pouch = false
          if section.settings.image == blank and section.settings.use_pouch_image
            assign use_pouch = true
          endif
        -%}
        <div class="nl-media{% if use_pouch %} nl-hero__packshot{% endif %}">
          {%- if use_pouch -%}
            <img
              src="{{ 'nurellea-gut-gummies-pouch.webp' | asset_url }}"
              srcset="{{ 'nurellea-gut-gummies-pouch-480.webp' | asset_url }} 480w, {{ 'nurellea-gut-gummies-pouch.webp' | asset_url }} 819w"
              sizes="(min-width: 990px) 40vw, 90vw"
              width="819"
              height="819"
              alt="Nurellea Gut Gummies pouch"
              loading="eager"
              fetchpriority="high"
            >
          {%- elsif section.settings.image != blank -%}
            {{
              section.settings.image
              | image_url: width: 1600
              | image_tag:
                widths: '480, 720, 960, 1200, 1600',
                sizes: '(min-width: 990px) 48vw, 100vw',
                loading: 'eager',
                fetchpriority: 'high',
                alt: section.settings.image.alt | default: section.settings.heading
            }}
          {%- elsif p.featured_media -%}
            {{
              p.featured_media.preview_image
              | image_url: width: 1600
              | image_tag:
                widths: '480, 720, 960, 1200, 1600',
                sizes: '(min-width: 990px) 48vw, 100vw',
                loading: 'eager',
                fetchpriority: 'high',
                alt: p.featured_media.alt | default: p.title
            }}
          {%- else -%}
            {% render 'nurellea-placeholder', label: 'Hero image — product lifestyle photo', art: 'jar' %}
          {%- endif -%}
        </div>
        {%- if p != blank and section.settings.show_price_chip -%}
          <div class="nl-hero__float nl-hero__float--a">
            <span class="nl-icon-badge">{% render 'nurellea-icon', name: 'gummy' %}</span>
            <span>
              {{ p.title | escape }}<br>
              <span class="nl-muted">{% if p.price_varies %}From {% endif %}{{ p.price_min | money }}</span>
            </span>
          </div>
        {%- endif -%}
        {%- if section.settings.chip_text != blank -%}
          <div class="nl-hero__float nl-hero__float--b">
            <span class="nl-icon-badge">{% render 'nurellea-icon', name: section.settings.chip_icon %}</span>
            <span>{{ section.settings.chip_text | escape }}</span>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Nurellea hero",
  "tag": "div",
  "settings": [
    { "type": "product", "id": "product", "label": "Product", "info": "Defaults to the primary product in Theme settings." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-2" },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Replaces the pouch image when set." },
    { "type": "checkbox", "id": "use_pouch_image", "label": "Show the Gut Gummies pouch", "default": true, "info": "Uncheck to use the product's featured image instead." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Gut gummies for women" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A daily ritual that feels" },
    { "type": "text", "id": "heading_accent", "label": "Heading accent (italic)", "default": "like self-care" },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Nurellea Gut Gummies turn your daily supplement into a moment you look forward to — chewable, simple and made to fit the way you live.</p>"
    },
    { "type": "text", "id": "button_label", "label": "Primary button label", "default": "Shop Gut Gummies" },
    { "type": "url", "id": "button_link", "label": "Primary button link", "info": "Defaults to the product page." },
    { "type": "text", "id": "button2_label", "label": "Secondary button label", "default": "See what's inside" },
    { "type": "url", "id": "button2_link", "label": "Secondary button link", "info": "e.g. the ingredients page" },
    { "type": "checkbox", "id": "show_price_chip", "label": "Show product price chip", "default": true },
    { "type": "text", "id": "chip_text", "label": "Floating chip text", "default": "Chewable gummy format" },
    {
      "type": "select",
      "id": "chip_icon",
      "label": "Floating chip icon",
      "default": "sparkle",
      "options": [
        { "value": "sparkle", "label": "Sparkle" },
        { "value": "heart", "label": "Heart" },
        { "value": "leaf", "label": "Leaf" },
        { "value": "flower", "label": "Flower" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Highlight",
      "limit": 3,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "check-circle",
          "options": [
            { "value": "check-circle", "label": "Check" },
            { "value": "list", "label": "List" },
            { "value": "calendar", "label": "Calendar" },
            { "value": "lock", "label": "Lock" },
            { "value": "truck", "label": "Truck" },
            { "value": "package", "label": "Package" },
            { "value": "heart", "label": "Heart" },
            { "value": "leaf", "label": "Leaf" }
          ]
        },
        { "type": "text", "id": "text", "label": "Text", "default": "Full ingredient transparency" }
      ]
    }
  ],
  "presets": [{ "name": "Nurellea hero" }]
}
{% endschema %}
