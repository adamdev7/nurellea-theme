<section class="nl-section color-{{ section.settings.color_scheme }}" aria-labelledby="Features-{{ section.id }}">
  <div class="nl-container">
    <header class="nl-section-head{% if section.settings.center %} nl-section-head--center{% endif %}" data-nl-reveal>
      {%- if section.settings.eyebrow != blank -%}<p class="nl-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2 id="Features-{{ section.id }}" class="nl-h2">
        {{ section.settings.heading | escape }}
        {%- if section.settings.heading_accent != blank %} <em class="nl-accent">{{ section.settings.heading_accent | escape }}</em>{%- endif -%}
      </h2>
      {%- if section.settings.text != blank -%}<div class="nl-lead nl-muted">{{ section.settings.text }}</div>{%- endif -%}
    </header>

    {%- assign cols = section.blocks.size | at_most: 4 | at_least: 1 -%}
    <div class="nl-grid nl-grid--{{ cols }}">
      {%- for block in section.blocks -%}
        <article class="nl-feature{% if section.settings.style == 'card' %} nl-card nl-card--hover{% elsif section.settings.style == 'soft' %} nl-card nl-card--soft{% endif %}" data-nl-reveal style="--nl-reveal-delay: {{ forloop.index0 | times: 80 }}ms" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <div class="nl-media nl-media--square" style="border-radius: var(--nl-radius);">
              {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '320, 480, 640, 800', sizes: '(min-width: 990px) 25vw, (min-width: 750px) 50vw, 100vw', alt: block.settings.image.alt | default: block.settings.title }}
            </div>
          {%- else -%}
            <span class="nl-icon-badge">{% render 'nurellea-icon', name: block.settings.icon %}</span>
          {%- endif -%}
          <h3 class="nl-feature__title">{{ block.settings.title | escape }}</h3>
          {%- if block.settings.text != blank -%}<div class="nl-feature__text">{{ block.settings.text }}</div>{%- endif -%}
        </article>
      {%- endfor -%}
    </div>

    {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
      <div class="nl-actions" style="margin-top: 40px; justify-content: {% if section.settings.center %}center{% else %}flex-start{% endif %};">
        <a class="button-secondary nl-btn" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Nurellea features",
  "tag": "div",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why Nurellea" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Wellness made" },
    { "type": "text", "id": "heading_accent", "label": "Heading accent (italic)", "default": "softer & simpler" },
    { "type": "richtext", "id": "text", "label": "Text" },
    {
      "type": "select",
      "id": "style",
      "label": "Card style",
      "default": "soft",
      "options": [
        { "value": "plain", "label": "Plain" },
        { "value": "soft", "label": "Soft" },
        { "value": "card", "label": "Card" }
      ]
    },
    { "type": "checkbox", "id": "center", "label": "Center heading", "default": true },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "heart",
          "options": [
            { "value": "heart", "label": "Heart" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "gummy", "label": "Gummy" },
            { "value": "list", "label": "List" },
            { "value": "flask", "label": "Flask" },
            { "value": "calendar", "label": "Calendar" },
            { "value": "flower", "label": "Flower" },
            { "value": "droplet", "label": "Droplet" },
            { "value": "sun", "label": "Sun" },
            { "value": "moon", "label": "Moon" },
            { "value": "shield", "label": "Shield" },
            { "value": "truck", "label": "Truck" },
            { "value": "chat", "label": "Chat" }
          ]
        },
        { "type": "image_picker", "id": "image", "label": "Image (replaces icon)" },
        { "type": "text", "id": "title", "label": "Title", "default": "Feature" },
        { "type": "richtext", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [{ "name": "Nurellea features" }]
}
{% endschema %}
