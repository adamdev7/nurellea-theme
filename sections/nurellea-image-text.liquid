<section class="nl-section color-{{ section.settings.color_scheme }}" aria-labelledby="ImageText-{{ section.id }}">
  <div class="nl-container">
    <div class="nl-split{% if section.settings.reverse %} nl-split--reverse{% endif %}">
      <div class="nl-split__media" data-nl-reveal>
        <div class="nl-media" style="--nl-ratio: {{ section.settings.ratio }};">
          {%- if section.settings.image != blank -%}
            {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '480, 720, 960, 1200, 1400', sizes: '(min-width: 990px) 50vw, 100vw', alt: section.settings.image.alt | default: '' }}
          {%- else -%}
            {% render 'nurellea-placeholder', label: section.settings.placeholder_label, art: section.settings.placeholder_art %}
          {%- endif -%}
        </div>
      </div>
      <div class="nl-split__content" data-nl-reveal>
        {%- if section.settings.eyebrow != blank -%}<p class="nl-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2 id="ImageText-{{ section.id }}" class="nl-h2">
          {{ section.settings.heading | escape }}
          {%- if section.settings.heading_accent != blank %} <em class="nl-accent">{{ section.settings.heading_accent | escape }}</em>{%- endif -%}
        </h2>
        {%- if section.settings.text != blank -%}<div class="nl-prose">{{ section.settings.text }}</div>{%- endif -%}
        {%- if section.blocks.size > 0 -%}
          <ul class="nl-checklist">
            {%- for block in section.blocks -%}
              <li {{ block.shopify_attributes }}>{% render 'nurellea-icon', name: 'check-circle' %}<span>{% if block.settings.title != blank %}<strong>{{ block.settings.title | escape }}</strong> {% endif %}{{ block.settings.text | escape }}</span></li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
        {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
          <div class="nl-actions">
            <a class="{% if section.settings.button_style == 'primary' %}button{% else %}button-secondary{% endif %} nl-btn" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }}</a>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Nurellea image with text",
  "tag": "div",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "placeholder_label", "label": "Placeholder label", "default": "Brand lifestyle photo" },
    {
      "type": "select",
      "id": "placeholder_art",
      "label": "Placeholder art",
      "default": "portrait",
      "options": [
        { "value": "portrait", "label": "Portrait" },
        { "value": "jar", "label": "Jar" },
        { "value": "gummy", "label": "Gummy" },
        { "value": "botanical", "label": "Botanical" },
        { "value": "routine", "label": "Routine" }
      ]
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Image ratio",
      "default": "4 / 5",
      "options": [
        { "value": "1 / 1", "label": "Square" },
        { "value": "4 / 5", "label": "Portrait" },
        { "value": "4 / 3", "label": "Landscape" }
      ]
    },
    { "type": "checkbox", "id": "reverse", "label": "Image on right", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our approach" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Wellness that feels" },
    { "type": "text", "id": "heading_accent", "label": "Heading accent (italic)", "default": "gentle" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "default": "secondary",
      "options": [
        { "value": "primary", "label": "Primary" },
        { "value": "secondary", "label": "Secondary" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Point",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "text", "id": "text", "label": "Text", "default": "A clear, honest label" }
      ]
    }
  ],
  "presets": [{ "name": "Nurellea image with text" }]
}
{% endschema %}
