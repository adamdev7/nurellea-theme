{%- liquid
  if section.settings.background != blank
    assign bg = section.settings.background | image_url: width: 1920
  else
    assign bg = 'nl-home-clouds.webp' | asset_url
  endif
-%}
<section class="nh nh-section nh-crave" style="--bg: url('{{ bg }}');" aria-labelledby="NhCrave-{{ section.id }}" data-nh-crave>
  <div class="nh-wrap">
    <div class="nh-head">
      <h2 id="NhCrave-{{ section.id }}" class="nh-title">{{ section.settings.heading | escape }}</h2>
    </div>
    {%- if section.settings.tab_2 != blank -%}
      <div class="nh-tabs" role="tablist" aria-label="{{ section.settings.heading | escape }}">
        <button type="button" class="nh-tab nh-tab--sm" role="tab" aria-selected="true" data-nh-set="1">{{ section.settings.tab_1 | escape }}</button>
        <button type="button" class="nh-tab nh-tab--sm" role="tab" aria-selected="false" data-nh-set="2">{{ section.settings.tab_2 | escape }}</button>
      </div>
    {%- endif -%}

    <div class="nh-crave__stage">
      <div class="nh-crave__center">
        <span data-nh-img="1">
          {% render 'nurellea-home-img', image: section.settings.image_1, asset: 'nl-home-splash.webp', width: 900, height: 900, alt: section.settings.image_1_alt, sizes: '(min-width: 990px) 30vw, 66vw' %}
        </span>
        {%- if section.settings.tab_2 != blank -%}
          <span data-nh-img="2" hidden>
            {% render 'nurellea-home-img', image: section.settings.image_2, asset: 'nurellea-gut-gummies-pouch.webp', asset_small: 'nurellea-gut-gummies-pouch-480.webp', small_w: 480, width: 819, height: 819, alt: section.settings.image_2_alt, sizes: '(min-width: 990px) 30vw, 66vw' %}
          </span>
        {%- endif -%}
      </div>

      {%- for set in (1..2) -%}
        {%- assign set_key = set | append: '' -%}
        <div class="nh-crave__set" data-nh-stickers="{{ set }}"{% if set == 2 %} hidden{% endif %}>
          {%- assign count = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.settings.set == set_key and count < 6 -%}
              {%- assign count = count | plus: 1 -%}
              {%- assign shape = block.settings.shape -%}
              <span class="nh-sticker nh-sticker--{{ shape | replace: '-cream', '' }}{% if shape contains 'cream' %} nh-sticker--cream{% endif %}" {{ block.shopify_attributes }}>
                {%- if block.settings.icon != 'none' -%}{% render 'nurellea-icon', name: block.settings.icon %}{%- endif -%}
                <span>{{ block.settings.text | escape }}</span>
              </span>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endfor -%}

      <span class="nh-spark" style="left: 31%; top: 20%; --s: 26px;" aria-hidden="true"></span>
      <span class="nh-spark" style="right: 30%; top: 47%; --s: 22px;" aria-hidden="true"></span>
      <span class="nh-spark" style="left: 32%; top: 58%; --s: 20px;" aria-hidden="true"></span>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Home: benefit stickers",
  "tag": "div",
  "max_blocks": 16,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Taste You Crave With The Benefits You Need" },
    { "type": "image_picker", "id": "background", "label": "Background", "info": "Defaults to the bundled pink clouds." },
    { "type": "text", "id": "tab_1", "label": "Tab 1", "default": "In every gummy" },
    { "type": "text", "id": "tab_2", "label": "Tab 2", "default": "What we leave out", "info": "Leave empty to hide the tabs and show set 1 only." },
    { "type": "image_picker", "id": "image_1", "label": "Center image (tab 1)", "info": "Defaults to the gummy splash. Photos on white blend into the clouds." },
    { "type": "text", "id": "image_1_alt", "label": "Center image alt (tab 1)", "default": "Stack of raspberry gummies in a pink splash" },
    { "type": "image_picker", "id": "image_2", "label": "Center image (tab 2)", "info": "Defaults to the Gut Gummies pouch." },
    { "type": "text", "id": "image_2_alt", "label": "Center image alt (tab 2)", "default": "Nurellea Gut Gummies pouch" }
  ],
  "blocks": [
    {
      "type": "sticker",
      "name": "Sticker",
      "settings": [
        { "type": "select", "id": "set", "label": "Tab", "options": [{ "value": "1", "label": "Tab 1" }, { "value": "2", "label": "Tab 2" }], "default": "1" },
        { "type": "text", "id": "text", "label": "Text", "default": "10 mushrooms" },
        { "type": "select", "id": "shape", "label": "Shape", "options": [
          { "value": "oval", "label": "Oval" },
          { "value": "rect", "label": "Tag" },
          { "value": "scallop", "label": "Scalloped (pink)" },
          { "value": "scallop-cream", "label": "Scalloped (cream)" }
        ], "default": "oval" },
        { "type": "select", "id": "icon", "label": "Icon", "options": [
          { "value": "none", "label": "None" },
          { "value": "mushroom", "label": "Mushroom" },
          { "value": "gummy", "label": "Gummy" },
          { "value": "leaf", "label": "Leaf" },
          { "value": "heart", "label": "Heart" },
          { "value": "flask", "label": "Lab" },
          { "value": "sparkle", "label": "Sparkle" },
          { "value": "flower", "label": "Flower" },
          { "value": "shield", "label": "Shield" },
          { "value": "bolt", "label": "Bolt" },
          { "value": "brain", "label": "Brain" },
          { "value": "close", "label": "Cross" }
        ], "default": "mushroom" }
      ]
    }
  ],
  "presets": [{ "name": "Home: benefit stickers" }]
}
{% endschema %}
