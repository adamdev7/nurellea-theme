{%- liquid
  assign half = section.blocks.size | plus: 1 | divided_by: 2
-%}
<section class="nl-section color-{{ section.settings.color_scheme }} nl-orbit" aria-labelledby="Orbit-{{ section.id }}">
  <div class="nl-container">
    <header class="nl-section-head nl-section-head--center" data-nl-reveal>
      {%- if section.settings.eyebrow != blank -%}<p class="nl-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2 id="Orbit-{{ section.id }}" class="nl-h2">
        {{ section.settings.heading | escape }}
        {%- if section.settings.heading_accent != blank %} <em class="nl-accent">{{ section.settings.heading_accent | escape }}</em>{%- endif -%}
      </h2>
      {%- if section.settings.text != blank -%}<div class="nl-lead nl-muted">{{ section.settings.text }}</div>{%- endif -%}
    </header>

    <div class="nl-orbit__layout">
      <ul class="nl-orbit__col nl-orbit__col--start" role="list">
        {%- for block in section.blocks limit: half -%}
          <li class="nl-orbit__item" data-nl-reveal style="--nl-reveal-delay: {{ forloop.index0 | times: 80 }}ms" {{ block.shopify_attributes }}>
            <span class="nl-orbit__icon">{% render 'nurellea-icon', name: block.settings.icon %}</span>
            <span class="nl-orbit__copy">
              <span class="nl-orbit__title">{{ block.settings.title | escape }}</span>
              {%- if block.settings.text != blank -%}<span class="nl-orbit__text">{{ block.settings.text | escape }}</span>{%- endif -%}
            </span>
          </li>
        {%- endfor -%}
      </ul>

      <div class="nl-orbit__media" data-nl-reveal>
        <span class="nl-orbit__ring" aria-hidden="true"></span>
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '400, 600, 800, 1000', sizes: '(min-width: 990px) 34vw, 80vw', alt: section.settings.image.alt | default: 'Nurellea Gut Gummies' }}
        {%- else -%}
          <img
            src="{{ 'nurellea-gut-gummies-pouch.webp' | asset_url }}"
            srcset="{{ 'nurellea-gut-gummies-pouch-480.webp' | asset_url }} 480w, {{ 'nurellea-gut-gummies-pouch.webp' | asset_url }} 819w"
            sizes="(min-width: 990px) 34vw, 80vw"
            width="819"
            height="819"
            alt="Nurellea Gut Gummies pouch"
            loading="lazy"
          >
        {%- endif -%}
      </div>

      <ul class="nl-orbit__col nl-orbit__col--end" role="list">
        {%- for block in section.blocks offset: half -%}
          <li class="nl-orbit__item" data-nl-reveal style="--nl-reveal-delay: {{ forloop.index0 | times: 80 }}ms" {{ block.shopify_attributes }}>
            <span class="nl-orbit__icon">{% render 'nurellea-icon', name: block.settings.icon %}</span>
            <span class="nl-orbit__copy">
              <span class="nl-orbit__title">{{ block.settings.title | escape }}</span>
              {%- if block.settings.text != blank -%}<span class="nl-orbit__text">{{ block.settings.text | escape }}</span>{%- endif -%}
            </span>
          </li>
        {%- endfor -%}
      </ul>
    </div>

    {%- if section.settings.button_label != blank -%}
      <div class="nl-actions" style="margin-top: 40px; justify-content: center;">
        <a class="button nl-btn" href="{{ section.settings.button_link | default: '#MainContent' }}">{{ section.settings.button_label | escape }}</a>
      </div>
    {%- endif -%}
    {%- if section.settings.show_disclaimer and settings.supplement_disclaimer != blank -%}
      <p class="nl-small nl-muted nl-orbit__note">{{ settings.supplement_disclaimer | strip_html | escape }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Nurellea benefit orbit",
  "tag": "div",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-2" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "10 mushrooms. 1 gummy." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Elevate your" },
    { "type": "text", "id": "heading_accent", "label": "Heading accent (italic)", "default": "everyday" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "image_picker", "id": "image", "label": "Center image", "info": "Defaults to the Gut Gummies pouch." },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Defaults to the buy box on this page." },
    { "type": "checkbox", "id": "show_disclaimer", "label": "Show supplement disclaimer", "default": true }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "limit": 8,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "sparkle",
          "options": [
            { "value": "brain", "label": "Brain" },
            { "value": "bolt", "label": "Energy" },
            { "value": "moon", "label": "Moon" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "shield", "label": "Shield" },
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "heart", "label": "Heart" },
            { "value": "droplet", "label": "Droplet" },
            { "value": "flower", "label": "Flower" },
            { "value": "mushroom", "label": "Mushroom" },
            { "value": "sun", "label": "Sun" }
          ]
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Benefit" },
        { "type": "text", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [{ "name": "Nurellea benefit orbit" }]
}
{% endschema %}
