{%- doc -%}
  Supplement facts panel. Sources, in order: product metafield nurellea.supplement_facts (JSON),
  nurellea.supplement_facts_image (image of the approved label), then the label facts in
  Theme settings > Nurellea product facts ("Name | Amount | %DV" per line).
  JSON shape: { "serving_size": "", "servings_per_container": "", "rows": [{ "name": "", "amount": "", "dv": "" }], "footnote": "" }

  @param {object} product - Product
{%- enddoc -%}
{%- liquid
  assign facts = product.metafields.nurellea.supplement_facts.value
  assign facts_image = product.metafields.nurellea.supplement_facts_image.value
  assign serving_size = facts.serving_size | default: product.metafields.nurellea.serving_size.value | default: settings.facts_serving_size
  assign servings = facts.servings_per_container | default: product.metafields.nurellea.servings_per_container.value | default: settings.facts_servings
  assign footnote = facts.footnote | default: settings.facts_footnote
  assign setting_rows = settings.facts_rows | strip | newline_to_br | split: '<br />'
-%}
{%- if facts.rows.size > 0 or facts_image == blank and settings.facts_rows != blank -%}
  <div class="nl-facts" role="region" aria-label="Supplement facts">
    <div class="nl-facts__title">Supplement Facts</div>
    <div class="nl-facts__serving">
      {%- if serving_size != blank -%}<div>Serving size: <strong>{{ serving_size | escape }}</strong></div>{%- endif -%}
      {%- if servings != blank -%}<div>Servings per container: <strong>{{ servings | escape }}</strong></div>{%- endif -%}
    </div>
    <table>
      <thead>
        <tr>
          <th scope="col"><span class="visually-hidden">Ingredient</span></th>
          <th scope="col">Amount per serving</th>
          <th scope="col">% Daily Value</th>
        </tr>
      </thead>
      <tbody>
        {%- if facts.rows.size > 0 -%}
          {%- for row in facts.rows -%}
            <tr>
              <th scope="row">{{ row.name | escape }}</th>
              <td>{{ row.amount | escape }}</td>
              <td>{{ row.dv | default: '' | escape }}</td>
            </tr>
          {%- endfor -%}
        {%- else -%}
          {%- for line in setting_rows -%}
            {%- assign cells = line | split: '|' -%}
            {%- assign row_name = cells[0] | strip -%}
            {%- if row_name != blank -%}
              <tr>
                <th scope="row">{{ row_name | escape }}</th>
                <td>{{ cells[1] | strip | escape }}</td>
                <td>{{ cells[2] | strip | escape }}</td>
              </tr>
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      </tbody>
    </table>
    {%- if footnote != blank -%}
      <div class="nl-facts__foot">{{ footnote | escape | newline_to_br }}</div>
    {%- endif -%}
  </div>
{%- elsif facts_image != blank -%}
  {{
    facts_image
    | image_url: width: 900
    | image_tag:
      class: 'nl-facts-image',
      loading: 'lazy',
      widths: '420, 640, 900',
      sizes: '(min-width: 990px) 420px, 100vw',
      alt: facts_image.alt | default: 'Supplement facts label'
  }}
{%- elsif request.design_mode -%}
  <p class="nl-setup-note" role="note">
    <strong>Product facts needed:</strong> fill Theme settings &gt; Nurellea product facts, or add the product metafield
    <code>nurellea.supplement_facts</code> (JSON) or the label image <code>nurellea.supplement_facts_image</code>.
    Nothing is shown to shoppers until it is set.
  </p>
{%- endif -%}
