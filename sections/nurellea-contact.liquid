<section class="nl-section color-{{ section.settings.color_scheme }}" aria-labelledby="Contact-{{ section.id }}">
  <div class="nl-container">
    <div class="nl-split" style="align-items: start;">
      <div class="nl-stack">
        {%- if section.settings.eyebrow != blank -%}<p class="nl-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2 id="Contact-{{ section.id }}" class="nl-h2">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.text != blank -%}<div class="nl-lead nl-muted">{{ section.settings.text }}</div>{%- endif -%}

        <div class="nl-stack nl-stack--sm" style="margin-top: 12px;">
          {%- if settings.brand_support_email != blank -%}
            <a class="nl-card nl-card--soft" href="mailto:{{ settings.brand_support_email }}" style="display:flex;gap:16px;align-items:center;text-decoration:none;">
              <span class="nl-icon-badge" style="background:#fff;">{% render 'nurellea-icon', name: 'mail' %}</span>
              <span><strong>Email</strong><br><span class="nl-muted">{{ settings.brand_support_email }}</span></span>
            </a>
          {%- endif -%}
          {%- if settings.brand_support_phone != blank -%}
            <a class="nl-card nl-card--soft" href="tel:{{ settings.brand_support_phone | remove: ' ' }}" style="display:flex;gap:16px;align-items:center;text-decoration:none;">
              <span class="nl-icon-badge" style="background:#fff;">{% render 'nurellea-icon', name: 'phone' %}</span>
              <span><strong>Phone</strong><br><span class="nl-muted">{{ settings.brand_support_phone }}</span></span>
            </a>
          {%- endif -%}
          {%- if settings.brand_support_hours != blank or settings.brand_response_time != blank -%}
            <div class="nl-card nl-card--soft" style="display:flex;gap:16px;align-items:center;">
              <span class="nl-icon-badge" style="background:#fff;">{% render 'nurellea-icon', name: 'clock' %}</span>
              <span>
                {%- if settings.brand_support_hours != blank -%}<strong>Hours</strong><br><span class="nl-muted">{{ settings.brand_support_hours | escape }}</span>{%- endif -%}
                {%- if settings.brand_response_time != blank -%}<br><span class="nl-muted">{{ settings.brand_response_time | escape }}</span>{%- endif -%}
              </span>
            </div>
          {%- endif -%}
          <a class="nl-card nl-card--soft" href="/pages/track-order" style="display:flex;gap:16px;align-items:center;text-decoration:none;">
            <span class="nl-icon-badge" style="background:#fff;">{% render 'nurellea-icon', name: 'package' %}</span>
            <span><strong>Where is my order?</strong><br><span class="nl-muted">Track it with your order number and email.</span></span>
          </a>
          {%- if settings.brand_business_address != blank -%}
            <p class="nl-small nl-muted">{{ settings.brand_legal_name | default: shop.name | escape }}<br>{{ settings.brand_business_address | escape | newline_to_br }}</p>
          {%- endif -%}
          {%- if settings.brand_support_email == blank and request.design_mode -%}
            <p class="nl-setup-note">Add the Nurellea support email, phone and hours in Theme settings &gt; Nurellea store. Form messages are delivered to the store's sender email set in Shopify admin &gt; Settings &gt; Notifications.</p>
          {%- endif -%}
        </div>
      </div>

      <div class="nl-card" style="padding: clamp(24px, 4vw, 44px);">
        {%- form 'contact', id: 'ContactForm', class: 'nl-form' -%}
          {%- if form.posted_successfully? -%}
            <div class="nl-alert nl-alert--success" role="status" tabindex="-1" autofocus>
              {% render 'nurellea-icon', name: 'check-circle' %}
              <span>Thank you — your message was sent. {% if settings.brand_response_time != blank %}{{ settings.brand_response_time | escape }}{% else %}We will reply to the email address you provided.{% endif %}</span>
            </div>
          {%- elsif form.errors -%}
            <div class="nl-alert nl-alert--error" role="alert" tabindex="-1" autofocus>
              {% render 'nurellea-icon', name: 'alert' %}
              <div>Your message could not be sent. Please check the highlighted fields.{{ form.errors | default_errors }}</div>
            </div>
          {%- endif -%}
          <div class="nl-form__row">
            <div class="nl-field">
              <label for="ContactName">Name</label>
              <input id="ContactName" type="text" name="contact[name]" autocomplete="name" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}">
            </div>
            <div class="nl-field">
              <label for="ContactEmail">Email <span class="nl-required" aria-hidden="true">*</span></label>
              <input id="ContactEmail" type="email" name="contact[email]" autocomplete="email" required aria-required="true" value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}" {% if form.errors contains 'email' %}aria-invalid="true" aria-describedby="ContactEmail-error"{% endif %}>
              {%- if form.errors contains 'email' -%}<span id="ContactEmail-error" class="nl-field__hint" style="color: var(--nl-error);">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</span>{%- endif -%}
            </div>
          </div>
          <div class="nl-form__row">
            <div class="nl-field">
              <label for="ContactTopic">Topic</label>
              <select id="ContactTopic" name="contact[Topic]">
                <option>Order question</option>
                <option>Product question</option>
                <option>Shipping &amp; delivery</option>
                <option>Returns</option>
                <option>Wholesale or press</option>
                <option>Something else</option>
              </select>
            </div>
            <div class="nl-field">
              <label for="ContactOrder">Order number (optional)</label>
              <input id="ContactOrder" type="text" name="contact[Order number]" inputmode="numeric">
            </div>
          </div>
          <div class="nl-field">
            <label for="ContactBody">Message <span class="nl-required" aria-hidden="true">*</span></label>
            <textarea id="ContactBody" name="contact[body]" required aria-required="true">{{ form.body }}</textarea>
          </div>
          <p class="nl-small nl-muted">Please don't include payment details. {% if shop.privacy_policy.body != blank %}See our <a href="{{ shop.privacy_policy.url }}">privacy policy</a>.{% endif %}</p>
          <div><button type="submit" class="button nl-btn">Send message</button></div>
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Nurellea contact",
  "tag": "div",
  "settings": [
    { "type": "paragraph", "content": "Uses Shopify's contact form. Support details come from Theme settings > Nurellea store." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Customer care" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "We're here to help" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Questions about an order, our gummies or anything else? Send us a message and our team will get back to you by email.</p>" }
  ],
  "presets": [{ "name": "Nurellea contact" }]
}
{% endschema %}
